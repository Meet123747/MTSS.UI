@{
    Layout = "_SuperAdminLayout";
    ViewData["Title"] = "Payments";
    var payments = new[]
    {
        new { Id = "TXN-DEMO-1001", Society = "Green Valley Residency", Plan = "MTSS Basic", Amount = 4999m, Date = "18 Nov 2026", Method = "Online", Status = "Paid" },
        new { Id = "TXN-DEMO-1002", Society = "MÈÉT MRÛG", Plan = "Home", Amount = 2999m, Date = "24 Nov 2026", Method = "Online", Status = "Pending" },
        new { Id = "TXN-DEMO-1003", Society = "Sample Heights", Plan = "MTSS Basic", Amount = 4999m, Date = "12 Nov 2026", Method = "Bank Transfer", Status = "Failed" },
        new { Id = "TXN-DEMO-1004", Society = "Sunrise Residency", Plan = "Home", Amount = 2999m, Date = "05 Nov 2026", Method = "Online", Status = "Paid" }
    };
}


        <div class="page-heading">
            <div>
                <h2>Payments</h2>
                <div class="muted">View and monitor society subscription payment activity.</div>
            </div>
            <button class="btn btn-primary" type="button" onclick="exportPayments()">Export CSV</button>
        </div>

        <div class="demo-note">
            <strong>Demo view:</strong> These are sample records for UI development only. They are not real transactions and are not retrieved from the backend. Payment API integration will be added when JD provides the endpoint contract.
        </div>

        <div class="row g-3 mb-4">
            <div class="col-xl-3 col-md-6"><div class="stat-card"><div class="stat-label">Total Transactions (Sample)</div><div class="stat-value" id="totalCount">4</div></div></div>
            <div class="col-xl-3 col-md-6"><div class="stat-card"><div class="stat-label">Paid Amount (Sample)</div><div class="stat-value text-success" id="paidAmount">?7,998</div></div></div>
            <div class="col-xl-3 col-md-6"><div class="stat-card"><div class="stat-label">Pending Transactions</div><div class="stat-value text-warning" id="pendingCount">1</div></div></div>
            <div class="col-xl-3 col-md-6"><div class="stat-card"><div class="stat-label">Failed Transactions</div><div class="stat-value text-danger" id="failedCount">1</div></div></div>
        </div>

        <section class="content-card">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                <h5 class="mb-0 fw-bold">Transaction History</h5>
                <span class="muted small">Sample transaction data</span>
            </div>
            <div class="toolbar">
                <input type="text" id="searchInput" placeholder="Search transaction or society..." oninput="filterPayments()" />
                <select id="statusFilter" onchange="filterPayments()">
                    <option value="">All Statuses</option>
                    <option value="Paid">Paid</option>
                    <option value="Pending">Pending</option>
                    <option value="Failed">Failed</option>
                </select>
            </div>
            <div class="table-responsive">
                <table class="table align-middle mb-0 sup-data-table" id="paymentsTable">
                    <thead>
                        <tr>
                            <th>Transaction ID</th>
                            <th>Society</th>
                            <th>Subscription Plan</th>
                            <th>Amount</th>
                            <th>Payment Date</th>
                            <th>Method</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var payment in payments)
                    {
                        var statusClass = payment.Status == "Paid" ? "paid" : payment.Status == "Pending" ? "pending" : "failed";
                        <tr data-status="@payment.Status">
                            <td class="fw-semibold" data-label="Transaction ID">@payment.Id</td>
                            <td data-label="Society">@payment.Society</td>
                            <td data-label="Subscription plan">@payment.Plan</td>
                            <td data-label="Amount">?@payment.Amount.ToString("N0")</td>
                            <td data-label="Payment date">@payment.Date</td>
                            <td data-label="Method">@payment.Method</td>
                            <td data-label="Status"><span class="status @statusClass">@payment.Status</span></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            <div id="emptyMessage" class="text-center text-muted py-4" style="display:none;">No matching transactions found.</div>
        </section>

@section Scripts {
<script>function filterPayments() {
            const query = document.getElementById('searchInput').value.toLowerCase();
            const status = document.getElementById('statusFilter').value;
            const rows = document.querySelectorAll('#paymentsTable tbody tr');
            let visible = 0;

            rows.forEach(row => {
                const matchesText = row.innerText.toLowerCase().includes(query);
                const matchesStatus = !status || row.dataset.status === status;
                const show = matchesText && matchesStatus;
                row.style.display = show ? '' : 'none';
                if (show) visible++;
            });

            document.getElementById('emptyMessage').style.display = visible ? 'none' : 'block';
        }

        function exportPayments() {
            const rows = [...document.querySelectorAll('#paymentsTable tr')].filter(row => row.style.display !== 'none');
            const csv = rows.map(row => [...row.querySelectorAll('th,td')]
                .map(cell => '"' + cell.innerText.replace(/"/g, '""') + '"').join(',')).join('\n');
            const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
            const url = URL.createObjectURL(blob);
            const link = document.createElement('a');
            link.href = url;
            link.download = 'mtss-sample-payments.csv';
            link.click();
            URL.revokeObjectURL(url);
        }</script>
}
