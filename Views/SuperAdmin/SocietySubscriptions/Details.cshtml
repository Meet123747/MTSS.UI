@using System.Text.Json
@model MTSS.UI.Models.ApiModels.Societies.SocietyListItem

@{
    ViewData["Title"] = "Society Subscription Details";
    Layout = "_SuperAdminLayout";

   JsonElement? subscription = ViewBag.SubscriptionData is JsonElement data
    ? data
    : null;

    string ReadValue(string property)
    {
        if (subscription.HasValue &&
            subscription.Value.ValueKind == JsonValueKind.Object &&
            subscription.Value.TryGetProperty(property, out var value))
        {
            return value.ToString();
        }

        return "--";
    }

    var subscriptionId = ReadValue("societySubscriptionId");
    var planId = ReadValue("subscriptionPlanId");
    var status = ReadValue("status");
    var startDate = ReadValue("startDate");
    var endDate = ReadValue("endDate");
    var isActive = ReadValue("isActive");
    var hasSubscription = subscription.HasValue &&
                          subscription.Value.ValueKind == JsonValueKind.Object;
}



        <div class="mb-4">
            <a href="@Url.Action("SocietySubscriptions","SuperAdmin")" class="text-decoration-none">
                <span data-icon="arrowLeft" class="mtss-icon-sm"></span> Back to Society Subscriptions
            </a>
            <h2 class="page-title mt-3">Society Subscription Details</h2>
            <p class="text-secondary">View and manage the society's assigned subscription.</p>
        </div>

        @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }
        @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

        <div class="content-card">
            <h5 class="mb-4">Society Information</h5>
            <div class="row">
                <div class="col-md-4 detail-item">
                    <div class="detail-label">Society ID</div>
                    <div class="detail-value">#@Model.SocietyId</div>
                </div>
                <div class="col-md-4 detail-item">
                    <div class="detail-label">Society Name</div>
                    <div class="detail-value">@Model.Name</div>
                </div>
                <div class="col-md-4 detail-item">
                    <div class="detail-label">City</div>
                    <div class="detail-value">@Model.City</div>
                </div>
            </div>
        </div>

        <div class="content-card">
            <h5 class="mb-4">Subscription Information</h5>

            @if (hasSubscription)
        {
            <div class="row">
                <div class="col-md-4 detail-item">
                    <div class="detail-label">Subscription ID</div>
                    <div class="detail-value">@subscriptionId</div>
                </div>
                <div class="col-md-4 detail-item">
                    <div class="detail-label">Plan ID</div>
                    <div class="detail-value">@planId</div>
                </div>
                <div class="col-md-4 detail-item">
                    <div class="detail-label">Subscription Status</div>
                    <div class="detail-value">@status</div>
                </div>
                <div class="col-md-4 detail-item">
                    <div class="detail-label">Start Date</div>
                    <div class="detail-value">@startDate</div>
                </div>
                <div class="col-md-4 detail-item">
                    <div class="detail-label">End Date</div>
                    <div class="detail-value">@endDate</div>
                </div>
                <div class="col-md-4 detail-item">
                    <div class="detail-label">Active</div>
                    <div class="detail-value">
                        @if (bool.TryParse(isActive, out var active) && active)
                        {
                        <span class="status active-status">Active</span>
                        }
                        else
                        {
                        <span class="status inactive-status">Inactive</span>
                        }
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 flex-wrap">
                <a href="@Url.Action("EditSocietySubscription","SuperAdmin",new { societyId = Model.SocietyId })"
                   class="btn btn-primary">Edit Subscription</a>

                <form asp-controller="SuperAdmin"
                      asp-action="UpdateSocietySubscriptionStatus"
                      asp-route-societyId="@Model.SocietyId"
                      method="post"
                      onsubmit="return confirm('Update this subscription status?');">
                    @Html.AntiForgeryToken()

                    <input type="hidden" name="Status"
                           value="@(bool.TryParse(isActive, out var currentlyActive) && currentlyActive ? "Inactive" : "Active")" />
                    <input type="hidden" name="IsActive"
                           value="@(!(bool.TryParse(isActive, out var current) && current))" />

                    <button type="submit"
                            class="btn @(bool.TryParse(isActive, out var activeNow) && activeNow ? "btn-danger" : "btn-success")">
                        @(bool.TryParse(isActive, out var activeButton) && activeButton ? "Deactivate Subscription" : "Activate Subscription")
                    </button>
                </form>
            </div>
        }
        else
        {
            <div class="alert alert-warning mb-3">
                No subscription is currently assigned to this society.
            </div>

            <a href="@Url.Action("AssignSocietySubscription","SuperAdmin",new { societyId = Model.SocietyId })"
               class="btn btn-primary">
                Assign Subscription Plan
            </a>
        }
        </div>
