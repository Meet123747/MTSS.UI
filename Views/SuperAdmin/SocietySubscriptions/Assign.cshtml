
@model MTSS.UI.Models.ApiModels.SocietySubscriptions.SocietySubscriptionRequest

@{
    var society = ViewBag.Society as MTSS.UI.Models.ApiModels.Societies.SocietyListItem;
    var plans = ViewBag.SubscriptionPlans as List<MTSS.UI.Models.ApiModels.SubscriptionPlans.SubscriptionPlanListItem>
                ?? new List<MTSS.UI.Models.ApiModels.SubscriptionPlans.SubscriptionPlanListItem>();

    ViewData["Title"] = "Assign Subscription";
    Layout = "_SuperAdminLayout";
}



        <div class="mb-4">
            <a href="@Url.Action("SocietySubscriptions","SuperAdmin")" class="text-decoration-none">
                <span data-icon="arrowLeft" class="mtss-icon-sm"></span> Back to Society Subscriptions
            </a>
            <h2 class="page-title mt-3">Assign Subscription Plan</h2>
            <p class="text-secondary">Choose a plan and subscription period for this society.</p>
        </div>

        <div class="content-card">

            @if (society != null)
        {
            <div class="alert alert-light border">
                <strong>Society:</strong> @society.Name
                <span class="text-secondary ms-2">(@society.City)</span>
            </div>
        }

            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <form asp-controller="SuperAdmin"
                  asp-action="@(ViewContext.RouteData.Values["action"]?.ToString())"
                  asp-route-societyId="@society?.SocietyId"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label asp-for="SubscriptionPlanId" class="form-label fw-semibold">Subscription Plan</label>
                    <select asp-for="SubscriptionPlanId" class="form-select" required>
                        <option value="">Select a subscription plan</option>
                        @foreach (var plan in plans.Where(p => p.IsActive))
                    {
                        <option value="@plan.SubscriptionPlanId">
                            @plan.Name (Wings: @plan.MaxWings, Flats: @plan.MaxFlats)
                        </option>
                    }
                    </select>
                    <span asp-validation-for="SubscriptionPlanId" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="StartDate" class="form-label fw-semibold">Start Date</label>
                        <input asp-for="StartDate" type="date" class="form-control" required />
                        <span asp-validation-for="StartDate" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="EndDate" class="form-label fw-semibold">End Date</label>
                        <input asp-for="EndDate" type="date" class="form-control" required />
                        <span asp-validation-for="EndDate" class="text-danger"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a href="@Url.Action("SocietySubscriptions","SuperAdmin")"
                       class="btn btn-outline-secondary px-4">Cancel</a>
                    <button type="submit" class="btn btn-primary px-4">Assign Subscription</button>
                </div>
            </form>
        </div>
