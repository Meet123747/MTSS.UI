
@model MTSS.UI.Models.ApiModels.SocietySubscriptions.SocietySubscriptionRequest

@{
    var society = ViewBag.Society as MTSS.UI.Models.ApiModels.Societies.SocietyListItem;
    var plans = ViewBag.SubscriptionPlans as List<MTSS.UI.Models.ApiModels.SubscriptionPlans.SubscriptionPlanListItem>
                ?? new List<MTSS.UI.Models.ApiModels.SubscriptionPlans.SubscriptionPlanListItem>();

    ViewData["Title"] = "Assign Subscription";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>MTSS | Assign Subscription</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <style>
        body {
            margin: 0;
            background: #f4f6fa;
            font-family: Arial,sans-serif;
        }

        .sidebar {
            width: 250px;
            min-height: 100vh;
            background: #17243a;
            color: white;
            position: fixed;
            padding: 25px 18px;
        
            display: flex;
            flex-direction: column;
}

        .brand {
            font-size: 25px;
            font-weight: bold;
            margin-bottom: 40px;
        }

        .nav-link {
            color: #cbd5e1;
            padding: 12px 15px;
            margin-bottom: 8px;
            border-radius: 7px;
        }

            .nav-link.active, .nav-link:hover {
                background: #2563eb;
                color: white;
            }

        .main-content {
            margin-left: 250px;
            padding: 30px;
        }

        .content-card {
            background: white;
            border: 0;
            border-radius: 12px;
            padding: 28px;
            box-shadow: 0 3px 15px rgba(0,0,0,.04);
            max-width: 850px;
        }

        .page-title {
            font-weight: 600;
        }

        @@media(max-width:768px) {
            .sidebar {
                width: 100%;
                min-height: auto;
                position: relative;
            }

            .main-content {
                margin-left: 0;
                padding: 18px;
            }
        }
    
        .sidebar-bottom {
            margin-top: auto;
            padding-top: 16px;
        }

        .logout-link {
            display: block;
            width: 100%;
            text-align: left;
            color: #fca5a5;
            background: transparent;
            border: 0;
            border-radius: 7px;
            padding: 12px 15px;
            margin-bottom: 8px;
            cursor: pointer;
            font: inherit;
            text-decoration: none;
            transition: background-color 0.2s ease, color 0.2s ease;
        }

        .logout-link:hover,
        .logout-link:focus {
            background: #dc2626;
            color: #ffffff;
        }

    </style>
</head>
<body>

    <aside class="sidebar">
        <div class="brand">MTSS</div>
        <p class="text-uppercase text-secondary small">Main Menu</p>
        <nav class="nav flex-column">
            <a class="nav-link" href="@Url.Action("Index","SuperAdmin")">Dashboard</a>
            <a class="nav-link" href="@Url.Action("Societies","SuperAdmin")">Societies</a>
            <a class="nav-link" href="@Url.Action("SubscriptionPlans","SuperAdmin")">Subscription Plans</a>
            <a class="nav-link active" href="@Url.Action("SocietySubscriptions","SuperAdmin")">Society Subscriptions</a>
            <a class="nav-link" href="#">Payments</a>
            <a class="nav-link" href="#">Reports</a>
            <a class="nav-link" href="#">Settings</a>
        </nav>
    
        <div class="sidebar-bottom">
            <form asp-controller="Auth" asp-action="Logout" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="logout-link">
                    Logout
                </button>
            </form>
        </div>

    </aside>

    <main class="main-content">

        <div class="mb-4">
            <a href="@Url.Action("SocietySubscriptions","SuperAdmin")" class="text-decoration-none">
                ? Back to Society Subscriptions
            </a>
            <h2 class="page-title mt-3">Assign Subscription Plan</h2>
            <p class="text-secondary">Choose a plan and subscription period for this society.</p>
        </div>

        <div class="content-card">

            @if (society != null)
        {
            <div class="alert alert-light border">
                <strong>Society:</strong> @society.Name
                <span class="text-secondary ms-2">(@society.City)</span>
            </div>
        }

            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <form asp-controller="SuperAdmin"
                  asp-action="@(ViewContext.RouteData.Values["action"]?.ToString())"
                  asp-route-societyId="@society?.SocietyId"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label asp-for="SubscriptionPlanId" class="form-label fw-semibold">Subscription Plan</label>
                    <select asp-for="SubscriptionPlanId" class="form-select" required>
                        <option value="">Select a subscription plan</option>
                        @foreach (var plan in plans.Where(p => p.IsActive))
                    {
                        <option value="@plan.SubscriptionPlanId">
                            @plan.Name (Wings: @plan.MaxWings, Flats: @plan.MaxFlats)
                        </option>
                    }
                    </select>
                    <span asp-validation-for="SubscriptionPlanId" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="StartDate" class="form-label fw-semibold">Start Date</label>
                        <input asp-for="StartDate" type="date" class="form-control" required />
                        <span asp-validation-for="StartDate" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="EndDate" class="form-label fw-semibold">End Date</label>
                        <input asp-for="EndDate" type="date" class="form-control" required />
                        <span asp-validation-for="EndDate" class="text-danger"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a href="@Url.Action("SocietySubscriptions","SuperAdmin")"
                       class="btn btn-outline-secondary px-4">Cancel</a>
                    <button type="submit" class="btn btn-primary px-4">Assign Subscription</button>
                </div>
            </form>
        </div>
    </main>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
