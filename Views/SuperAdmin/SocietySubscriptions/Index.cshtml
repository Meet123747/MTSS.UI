
@model List<MTSS.UI.Models.ApiModels.Societies.SocietyListItem>

    @{
    ViewData["Title"] = "Society Subscriptions";
    Layout = "_SuperAdminLayout";
    }



            <div class="mb-4">
                <h2 class="page-title">Society Subscription Management</h2>
                <p class="text-secondary mb-0">Manage subscription plans assigned to societies.</p>
            </div>

            @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">@TempData["SuccessMessage"]</div>
        }

            @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
        }

            @if (ViewBag.ErrorMessage != null)
        {
            <div class="alert alert-danger">@ViewBag.ErrorMessage</div>
        }

            <div class="content-card">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
                    <h5 class="mb-0">All Societies</h5>
                    <input type="text" id="societySearch" class="form-control"
                           style="max-width:300px" placeholder="Search societies..." />
                </div>

                <div class="table-responsive">
                    <table class="table table-hover sup-data-table" id="societyTable">
                        <thead>
                            <tr>
                                <th>Society ID</th>
                                <th>Society Name</th>
                                <th>City</th>
                                <th>Society Status</th>
                                <th>Subscription</th>
                                <th>Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @if (Model != null && Model.Any())
                        {
                            foreach (var society in Model)
                            {
                            <tr>
                                <td data-label="Society ID">#@society.SocietyId</td>
                                <td data-label="Society name"><strong>@society.Name</strong></td>
                                <td data-label="City">@society.City</td>
                                <td data-label="Society status">
                                    @if (society.IsActive)
                                        {
                                    <span class="status active-status">Active</span>
                                        }
                                        else
                                        {
                                    <span class="status inactive-status">Inactive</span>
                                        }
                                </td>
                                <td data-label="Subscription"><span class="text-secondary">View assignment</span></td>
                                <td data-label="Actions">
                                    <a class="btn btn-sm btn-outline-primary"
                                       href="@Url.Action("SocietySubscriptionDetails", "SuperAdmin", new { societyId = society.SocietyId })">
                                        View
                                    </a>

                                    <a class="btn btn-sm btn-primary"
                                       href="@Url.Action("AssignSocietySubscription", "SuperAdmin", new { societyId = society.SocietyId })">
                                        Assign Plan
                                    </a>
                                </td>
                            </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center text-secondary py-5">
                                    No societies found.
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>

@section Scripts {
<script>
            document.getElementById("societySearch").addEventListener("input", function () {
                const value = this.value.toLowerCase();

                document.querySelectorAll("#societyTable tbody tr").forEach(row => {
                    row.style.display = row.innerText.toLowerCase().includes(value) ? "" : "none";
                });
            });
        </script>
}
