
@model List<MTSS.UI.Models.ApiModels.Societies.SocietyListItem>

    @{
    ViewData["Title"] = "Society Subscriptions";
    Layout = null;
    }

    <!DOCTYPE html>
    <html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>MTSS | Society Subscriptions</title>
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

        <style>
            body {
                margin: 0;
                background: #f4f6fa;
                font-family: Arial, sans-serif;
            }

            .sidebar {
                width: 250px;
                min-height: 100vh;
                background: #17243a;
                color: white;
                position: fixed;
                padding: 25px 18px;
            
            display: flex;
            flex-direction: column;
}

            .brand {
                font-size: 25px;
                font-weight: bold;
                margin-bottom: 40px;
            }

            .nav-link {
                color: #cbd5e1;
                padding: 12px 15px;
                margin-bottom: 8px;
                border-radius: 7px;
                text-decoration: none;
            }

                .nav-link.active,
                .nav-link:hover {
                    background: #2563eb;
                    color: white;
                }

            .logout-link {
                color: #fca5a5;
                background: transparent;
                cursor: pointer;
            }

                .logout-link:hover {
                    background: #7f1d1d;
                    color: white;
                }

            .main-content {
                margin-left: 250px;
                padding: 30px;
            }

            .content-card {
                background: white;
                border: 0;
                border-radius: 12px;
                padding: 24px;
                box-shadow: 0 3px 15px rgba(0,0,0,.04);
            }

            .page-title {
                font-weight: 600;
            }

            .table th {
                background: #f8fafc;
                color: #64748b;
                font-size: 13px;
                padding: 15px;
                white-space: nowrap;
            }

            .table td {
                padding: 16px 15px;
                vertical-align: middle;
            }

            .status {
                padding: 6px 12px;
                border-radius: 20px;
                font-size: 12px;
                font-weight: 600;
            }

            .active-status {
                background: #dcfce7;
                color: #15803d;
            }

            .inactive-status {
                background: #fee2e2;
                color: #b91c1c;
            }

            @@media(max-width:768px) {
                .sidebar {
                    width: 100%;
                    min-height: auto;
                    position: relative;
                }

                .main-content {
                    margin-left: 0;
                    padding: 18px;
                }
            }
        
        .sidebar-bottom {
            margin-top: auto;
            padding-top: 16px;
        }

        .logout-link {
            display: block;
            width: 100%;
            text-align: left;
            color: #fca5a5;
            background: transparent;
            border: 0;
            border-radius: 7px;
            padding: 12px 15px;
            margin-bottom: 8px;
            cursor: pointer;
            font: inherit;
            text-decoration: none;
            transition: background-color 0.2s ease, color 0.2s ease;
        }

        .logout-link:hover,
        .logout-link:focus {
            background: #dc2626;
            color: #ffffff;
        }

    </style>
    </head>

    <body>

        <aside class="sidebar">
            <div class="brand">MTSS</div>
            <p class="text-uppercase text-secondary small">Main Menu</p>

            <nav class="nav flex-column">
                <a class="nav-link" asp-controller="SuperAdmin" asp-action="Index">Dashboard</a>
                <a class="nav-link" asp-controller="SuperAdmin" asp-action="Societies">Societies</a>
                <a class="nav-link" asp-controller="SuperAdmin" asp-action="SubscriptionPlans">Subscription Plans</a>
                <a class="nav-link active" asp-controller="SuperAdmin" asp-action="SocietySubscriptions">Society Subscriptions</a>
                <a class="nav-link" asp-controller="SuperAdmin" asp-action="Payments">Payments</a>
                <a class="nav-link" asp-controller="SuperAdmin" asp-action="Reports">Reports</a>
                <a class="nav-link" asp-controller="SuperAdmin" asp-action="Settings">Settings</a>

                <hr class="border-secondary" />
            </nav>
        
        <div class="sidebar-bottom">
            <form asp-controller="Auth" asp-action="Logout" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="logout-link">
                    Logout
                </button>
            </form>
        </div>

    </aside>

        <main class="main-content">

            <div class="mb-4">
                <h2 class="page-title">Society Subscription Management</h2>
                <p class="text-secondary mb-0">Manage subscription plans assigned to societies.</p>
            </div>

            @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">@TempData["SuccessMessage"]</div>
        }

            @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
        }

            @if (ViewBag.ErrorMessage != null)
        {
            <div class="alert alert-danger">@ViewBag.ErrorMessage</div>
        }

            <div class="content-card">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
                    <h5 class="mb-0">All Societies</h5>
                    <input type="text" id="societySearch" class="form-control"
                           style="max-width:300px" placeholder="Search societies..." />
                </div>

                <div class="table-responsive">
                    <table class="table table-hover" id="societyTable">
                        <thead>
                            <tr>
                                <th>Society ID</th>
                                <th>Society Name</th>
                                <th>City</th>
                                <th>Society Status</th>
                                <th>Subscription</th>
                                <th>Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @if (Model != null && Model.Any())
                        {
                            foreach (var society in Model)
                            {
                            <tr>
                                <td>#@society.SocietyId</td>
                                <td><strong>@society.Name</strong></td>
                                <td>@society.City</td>
                                <td>
                                    @if (society.IsActive)
                                        {
                                    <span class="status active-status">Active</span>
                                        }
                                        else
                                        {
                                    <span class="status inactive-status">Inactive</span>
                                        }
                                </td>
                                <td><span class="text-secondary">View assignment</span></td>
                                <td>
                                    <a class="btn btn-sm btn-outline-primary"
                                       href="@Url.Action("SocietySubscriptionDetails", "SuperAdmin", new { societyId = society.SocietyId })">
                                        View
                                    </a>

                                    <a class="btn btn-sm btn-primary"
                                       href="@Url.Action("AssignSocietySubscription", "SuperAdmin", new { societyId = society.SocietyId })">
                                        Assign Plan
                                    </a>
                                </td>
                            </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center text-secondary py-5">
                                    No societies found.
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>

        </main>

        <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

        <script>
            document.getElementById("societySearch").addEventListener("input", function () {
                const value = this.value.toLowerCase();

                document.querySelectorAll("#societyTable tbody tr").forEach(row => {
                    row.style.display = row.innerText.toLowerCase().includes(value) ? "" : "none";
                });
            });
        </script>

    </body>
</html>
