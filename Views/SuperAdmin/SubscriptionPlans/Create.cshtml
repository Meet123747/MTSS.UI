
@model MTSS.UI.Models.ApiModels.SubscriptionPlans.SubscriptionPlanCreateRequest

@{
    ViewData["Title"] = "Create Subscription Plan";
    Layout = "_SuperAdminLayout";
}



        <div class="mb-4">

            <a asp-controller="SuperAdmin"
               asp-action="SubscriptionPlans"
               class="text-decoration-none">
                <span data-icon="arrowLeft" class="mtss-icon-sm"></span> Back to Subscription Plans
            </a>

            <h2 class="page-title mt-3">Create Subscription Plan</h2>

            <p class="text-secondary mb-0">
                Configure plan limits and available features.
            </p>

        </div>

        <div class="content-card">

            <form asp-controller="SuperAdmin"
                  asp-action="CreateSubscriptionPlan"
                  method="post">

                @Html.AntiForgeryToken()

                <!-- Basic Information -->
                <h5 class="section-title">Basic Information</h5>

                <div class="row mb-4">

                    <div class="col-md-6">
                        <label asp-for="Name" class="form-label">
                            Plan Name
                        </label>

                        <input asp-for="Name"
                               class="form-control"
                               placeholder="Enter plan name"
                               required />
                    </div>

                </div>

                <hr class="my-4" />

                <!-- Plan Limits -->
                <h5 class="section-title">Plan Limits</h5>

                <div class="row g-3 mb-4">

                    <div class="col-md-4">
                        <label asp-for="MaxWings" class="form-label">
                            Maximum Wings
                        </label>

                        <input asp-for="MaxWings"
                               type="number"
                               min="1"
                               class="form-control"
                               required />
                    </div>

                    <div class="col-md-4">
                        <label asp-for="MaxFloorsPerWing" class="form-label">
                            Maximum Floors Per Wing
                        </label>

                        <input asp-for="MaxFloorsPerWing"
                               type="number"
                               min="1"
                               class="form-control"
                               required />
                    </div>

                    <div class="col-md-4">
                        <label asp-for="MaxFlats" class="form-label">
                            Maximum Flats
                        </label>

                        <input asp-for="MaxFlats"
                               type="number"
                               min="1"
                               class="form-control"
                               required />
                    </div>

                    <div class="col-md-4">
                        <label asp-for="MaxAmenities" class="form-label">
                            Maximum Amenities
                        </label>

                        <input asp-for="MaxAmenities"
                               type="number"
                               min="1"
                               class="form-control"
                               required />
                    </div>

                    <div class="col-md-4">
                        <label asp-for="MaxSocietyAdmins" class="form-label">
                            Maximum Society Admins
                        </label>

                        <input asp-for="MaxSocietyAdmins"
                               type="number"
                               min="1"
                               class="form-control"
                               required />
                    </div>

                </div>

                <hr class="my-4" />

                <!-- Features -->
                <h5 class="section-title">Available Features</h5>

                <div class="row g-3 mb-4">

                    <div class="col-md-6">
                        <div class="feature-item">
                            <div class="form-check">
                                <input asp-for="GuestApprovalEnabled"
                                       class="form-check-input" />

                                <label asp-for="GuestApprovalEnabled"
                                       class="form-check-label">
                                    Guest Approval
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="feature-item">
                            <div class="form-check">
                                <input asp-for="ParcelRegisterEnabled"
                                       class="form-check-input" />

                                <label asp-for="ParcelRegisterEnabled"
                                       class="form-check-label">
                                    Parcel Register
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="feature-item">
                            <div class="form-check">
                                <input asp-for="AmenityPinEnabled"
                                       class="form-check-input" />

                                <label asp-for="AmenityPinEnabled"
                                       class="form-check-label">
                                    Amenity PIN
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="feature-item">
                            <div class="form-check">
                                <input asp-for="ComplaintManagementEnabled"
                                       class="form-check-input" />

                                <label asp-for="ComplaintManagementEnabled"
                                       class="form-check-label">
                                    Complaint Management
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="feature-item">
                            <div class="form-check">
                                <input asp-for="ReportsEnabled"
                                       class="form-check-input" />

                                <label asp-for="ReportsEnabled"
                                       class="form-check-label">
                                    Reports
                                </label>
                            </div>
                        </div>
                    </div>

                </div>

                <!-- Buttons -->
                <div class="d-flex gap-2 justify-content-end">

                    <a asp-controller="SuperAdmin"
                       asp-action="SubscriptionPlans"
                       class="btn btn-outline-secondary px-4">
                        Cancel
                    </a>

                    <button type="submit"
                            class="btn btn-primary px-4">
                        Create Plan
                    </button>

                </div>

            </form>

        </div>
