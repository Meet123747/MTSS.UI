
@model MTSS.UI.Models.ApiModels.SubscriptionPlans.SubscriptionPlanListItem

@{
    ViewData["Title"] = "Subscription Plan Details";
    Layout = "_SuperAdminLayout";
}



        <!-- Page Header -->
        <div class="mb-4">

            <a asp-controller="SuperAdmin"
               asp-action="SubscriptionPlans"
               class="text-decoration-none">
                <span data-icon="arrowLeft" class="mtss-icon-sm"></span> Back to Subscription Plans
            </a>

            <div class="mt-3">
                <h2 class="page-title">Subscription Plan Details</h2>

                <p class="text-secondary mb-0">
                    View subscription plan information and enabled features.
                </p>
            </div>

        </div>

        @if (TempData["SuccessMessage"] != null)
        {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
        }

        @if (Model != null)
        {
            <!-- Basic Information -->
        <div class="content-card">

            <h5 class="section-title">Basic Information</h5>

            <div class="row">

                <div class="col-md-4 detail-item">
                    <div class="detail-label">Plan ID</div>
                    <div class="detail-value">
                        #@Model.SubscriptionPlanId
                    </div>
                </div>

                <div class="col-md-4 detail-item">
                    <div class="detail-label">Plan Name</div>
                    <div class="detail-value">
                        @Model.Name
                    </div>
                </div>

                <div class="col-md-4 detail-item">
                    <div class="detail-label">Status</div>
                    <div class="detail-value">
                        @if (Model.IsActive)
                            {
                        <span class="status active-status">Active</span>
                            }
                            else
                            {
                        <span class="status inactive-status">Inactive</span>
                            }
                    </div>
                </div>

                <div class="col-md-4 detail-item">
                    <div class="detail-label">Created At</div>
                    <div class="detail-value">
                        @Model.CreatedAt.ToString("dd MMM yyyy")
                    </div>
                </div>

            </div>

        </div>

 <!-- Plan Limits -->
        <div class="content-card">

            <h5 class="section-title">Plan Limits</h5>

            <div class="row">

                <div class="col-md-4 detail-item">
                    <div class="detail-label">Maximum Wings</div>
                    <div class="detail-value">@Model.MaxWings</div>
                </div>

                <div class="col-md-4 detail-item">
                    <div class="detail-label">Maximum Floors Per Wing</div>
                    <div class="detail-value">@Model.MaxFloorsPerWing</div>
                </div>

                <div class="col-md-4 detail-item">
                    <div class="detail-label">Maximum Flats</div>
                    <div class="detail-value">@Model.MaxFlats</div>
                </div>

                <div class="col-md-4 detail-item">
                    <div class="detail-label">Maximum Amenities</div>
                    <div class="detail-value">@Model.MaxAmenities</div>
                </div>

                <div class="col-md-4 detail-item">
                    <div class="detail-label">Maximum Society Admins</div>
                    <div class="detail-value">@Model.MaxSocietyAdmins</div>
                </div>

            </div>

        </div>

 <!-- Enabled Features -->
        <div class="content-card">

            <h5 class="section-title">Available Features</h5>

            <div class="row g-3">

                <div class="col-md-6">
                    <div class="detail-label">Guest Approval</div>

                    @if (Model.GuestApprovalEnabled)
                        {
                    <span class="feature-status enabled">Enabled</span>
                        }
                        else
                        {
                    <span class="feature-status disabled">Disabled</span>
                        }
                </div>

                <div class="col-md-6">
                    <div class="detail-label">Parcel Register</div>

                    @if (Model.ParcelRegisterEnabled)
                        {
                    <span class="feature-status enabled">Enabled</span>
                        }
                        else
                        {
                    <span class="feature-status disabled">Disabled</span>
                        }
                </div>

                <div class="col-md-6">
                    <div class="detail-label">Amenity PIN</div>

                    @if (Model.AmenityPinEnabled)
                        {
                    <span class="feature-status enabled">Enabled</span>
                        }
                        else
                        {
                    <span class="feature-status disabled">Disabled</span>
                        }
                </div>

                <div class="col-md-6">
                    <div class="detail-label">Complaint Management</div>

                    @if (Model.ComplaintManagementEnabled)
                        {
                    <span class="feature-status enabled">Enabled</span>
                        }
                        else
                        {
                    <span class="feature-status disabled">Disabled</span>
                        }
                </div>

                <div class="col-md-6">
                    <div class="detail-label">Reports</div>

                    @if (Model.ReportsEnabled)
                        {
                    <span class="feature-status enabled">Enabled</span>
                        }
                        else
                        {
                    <span class="feature-status disabled">Disabled</span>
                        }
                </div>

            </div>

        </div>

 <!-- Action Buttons -->
        <div class="d-flex justify-content-end gap-2 flex-wrap mb-4">

            <a asp-controller="SuperAdmin"
               asp-action="SubscriptionPlans"
               class="btn btn-outline-secondary px-4">
                Back to Plans
            </a>

            <a asp-controller="SuperAdmin"
               asp-action="EditSubscriptionPlan"
               asp-route-id="@Model.SubscriptionPlanId"
               class="btn btn-primary px-4">
                Edit Plan
            </a>

            <form asp-controller="SuperAdmin"
                  asp-action="UpdateSubscriptionPlanStatus"
                  method="post"
                  class="d-inline"
                  onsubmit="return confirm('@(Model.IsActive ? "Are you sure you want to deactivate this subscription plan?" : "Are you sure you want to activate this subscription plan?")');">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="id"
                       value="@Model.SubscriptionPlanId" />

                <input type="hidden"
                       name="isActive"
                       value="@(!Model.IsActive ? "true" : "false")" />

                @if (Model.IsActive)
                    {
                <button type="submit"
                        class="btn btn-danger px-4">
                    Deactivate Plan
                </button>
                    }
                    else
                    {
                <button type="submit"
                        class="btn btn-success px-4">
                    Activate Plan
                </button>
                    }

            </form>

        </div>
        }
        else
        {
        <div class="alert alert-danger">
            Subscription plan information is not available.
        </div>
        }
