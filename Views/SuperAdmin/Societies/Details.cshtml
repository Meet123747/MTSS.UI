
@model MTSS.UI.Models.ApiModels.Societies.SocietyListItem

@{
    Layout = "_SuperAdminLayout";
    ViewData["Title"] = "Society Details";
}



        <div class="d-flex justify-content-between
                    align-items-center flex-wrap gap-3 mb-4">

            <div>
                <h2 class="fw-semibold">Society Details</h2>
                <p class="text-secondary mb-0">
                    View registered society information
                </p>
            </div>

            <div class="d-flex gap-2 flex-wrap">

                @if (Model != null)
                {
                <a asp-controller="SuperAdmin"
                   asp-action="EditSociety"
                   asp-route-id="@Model.SocietyId"
                   class="btn btn-primary">
                    Edit Society
                </a>

                <form asp-controller="SuperAdmin"
                      asp-action="UpdateSocietyStatus"
                      method="post"
                      onsubmit="return confirmStatusChange(@Model.IsActive);">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="id"
                           value="@Model.SocietyId" />

                    <input type="hidden"
                           name="isActive"
                           value="@(!Model.IsActive ? "true" : "false")" />

                    @if (Model.IsActive)
                        {
                    <button type="submit"
                            class="btn btn-danger">
                        Deactivate
                    </button>
                        }
                        else
                        {
                    <button type="submit"
                            class="btn btn-success">
                        Activate
                    </button>
                        }

                </form>
                }

                <a asp-controller="SuperAdmin"
                   asp-action="Societies"
                   class="btn btn-outline-secondary">
                    Back to Societies
                </a>

            </div>

        </div>

        @if (TempData["SuccessMessage"] != null)
        {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["SuccessMessage"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["ErrorMessage"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
        }

        @if (Model != null)
        {
        <div class="details-card">

            <div class="d-flex justify-content-between
                            align-items-center mb-4">

                <h4 class="mb-0">@Model.Name</h4>

                @if (Model.IsActive)
                    {
                <span class="status active-status">Active</span>
                    }
                    else
                    {
                <span class="status inactive-status">Inactive</span>
                    }

            </div>

            <hr />

            <div class="row mt-4">

                <div class="col-md-6">
                    <p class="detail-label">Society ID</p>
                    <p class="detail-value">@Model.SocietyId</p>
                </div>

                <div class="col-md-6">
                    <p class="detail-label">Society Name</p>
                    <p class="detail-value">@Model.Name</p>
                </div>

                <div class="col-md-6">
                    <p class="detail-label">Address</p>
                    <p class="detail-value">@Model.Address</p>
                </div>

                <div class="col-md-6">
                    <p class="detail-label">City</p>
                    <p class="detail-value">@Model.City</p>
                </div>

                <div class="col-md-6">
                    <p class="detail-label">State</p>
                    <p class="detail-value">@Model.State</p>
                </div>

                <div class="col-md-6">
                    <p class="detail-label">Pincode</p>
                    <p class="detail-value">@Model.Pincode</p>
                </div>

                <div class="col-md-6">
                    <p class="detail-label">Created At</p>
                    <p class="detail-value">
                        @Model.CreatedAt.ToString("dd MMM yyyy")
                    </p>
                </div>

            </div>

        </div>
        }

@section Scripts {
<script>function confirmStatusChange(isCurrentlyActive) {
            if (isCurrentlyActive) {
                return confirm(
                    "Are you sure you want to deactivate this society?"
                );
            }

            return confirm(
                "Are you sure you want to activate this society?"
            );
        }</script>
}
