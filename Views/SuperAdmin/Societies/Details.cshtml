
@model MTSS.UI.Models.ApiModels.Societies.SocietyListItem

@{
    Layout = null;
    ViewData["Title"] = "Society Details";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>MTSS | Society Details</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <style>
        body {
            background: #f4f6fa;
            font-family: Arial, sans-serif;
            margin: 0;
        }

        .sidebar {
            width: 250px;
            min-height: 100vh;
            background: #17243a;
            color: white;
            position: fixed;
            padding: 25px 18px;
        
            display: flex;
            flex-direction: column;
}

        .brand {
            font-size: 25px;
            font-weight: bold;
            margin-bottom: 40px;
        }

        .nav-link {
            color: #cbd5e1;
            padding: 12px 15px;
            margin-bottom: 8px;
            border-radius: 7px;
        }

            .nav-link:hover,
            .nav-link.active {
                background: #2563eb;
                color: white;
            }

        .main-content {
            margin-left: 250px;
            padding: 35px;
        }

        .details-card {
            background: white;
            padding: 30px;
            border-radius: 12px;
            box-shadow: 0 3px 15px rgba(0,0,0,0.04);
        }

        .detail-label {
            color: #64748b;
            font-size: 14px;
            margin-bottom: 7px;
        }

        .detail-value {
            font-size: 16px;
            font-weight: 600;
            margin-bottom: 25px;
        }

        .status {
            padding: 6px 14px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
        }

        .active-status {
            background: #dcfce7;
            color: #15803d;
        }

        .inactive-status {
            background: #fee2e2;
            color: #b91c1c;
        }

        @@media (max-width: 768px) {
            .sidebar {
                width: 100%;
                min-height: auto;
                position: relative;
            }

            .main-content {
                margin-left: 0;
                padding: 18px;
            }
        }
    
        .sidebar-bottom {
            margin-top: auto;
            padding-top: 16px;
        }

        .logout-link {
            display: block;
            width: 100%;
            text-align: left;
            color: #fca5a5;
            background: transparent;
            border: 0;
            border-radius: 7px;
            padding: 12px 15px;
            margin-bottom: 8px;
            cursor: pointer;
            font: inherit;
            text-decoration: none;
            transition: background-color 0.2s ease, color 0.2s ease;
        }

        .logout-link:hover,
        .logout-link:focus {
            background: #dc2626;
            color: #ffffff;
        }

    </style>
</head>

<body>

    <aside class="sidebar">
        <div class="brand">MTSS</div>

        <p class="text-uppercase text-secondary small">
            Main Menu
        </p>

        <nav class="nav flex-column">
            <a class="nav-link"
               asp-controller="SuperAdmin"
               asp-action="Index">
                Dashboard
            </a>

            <a class="nav-link active"
               asp-controller="SuperAdmin"
               asp-action="Societies">
                Societies
            </a>

            <a class="nav-link" href="#">Subscription Plans</a>
            <a class="nav-link" href="#">Payments</a>
            <a class="nav-link" href="#">Reports</a>
            <a class="nav-link" href="#">Settings</a>
        </nav>
    
        <div class="sidebar-bottom">
            <form asp-controller="Auth" asp-action="Logout" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="logout-link">
                    Logout
                </button>
            </form>
        </div>

    </aside>

    <main class="main-content">

        <div class="d-flex justify-content-between
                    align-items-center flex-wrap gap-3 mb-4">

            <div>
                <h2 class="fw-semibold">Society Details</h2>
                <p class="text-secondary mb-0">
                    View registered society information
                </p>
            </div>

            <div class="d-flex gap-2 flex-wrap">

                @if (Model != null)
                {
                <a asp-controller="SuperAdmin"
                   asp-action="EditSociety"
                   asp-route-id="@Model.SocietyId"
                   class="btn btn-primary">
                    Edit Society
                </a>

                <form asp-controller="SuperAdmin"
                      asp-action="UpdateSocietyStatus"
                      method="post"
                      onsubmit="return confirmStatusChange(@Model.IsActive);">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="id"
                           value="@Model.SocietyId" />

                    <input type="hidden"
                           name="isActive"
                           value="@(!Model.IsActive ? "true" : "false")" />

                    @if (Model.IsActive)
                        {
                    <button type="submit"
                            class="btn btn-danger">
                        Deactivate
                    </button>
                        }
                        else
                        {
                    <button type="submit"
                            class="btn btn-success">
                        Activate
                    </button>
                        }

                </form>
                }

                <a asp-controller="SuperAdmin"
                   asp-action="Societies"
                   class="btn btn-outline-secondary">
                    Back to Societies
                </a>

            </div>

        </div>

        @if (TempData["SuccessMessage"] != null)
        {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["SuccessMessage"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["ErrorMessage"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
        }

        @if (Model != null)
        {
        <div class="details-card">

            <div class="d-flex justify-content-between
                            align-items-center mb-4">

                <h4 class="mb-0">@Model.Name</h4>

                @if (Model.IsActive)
                    {
                <span class="status active-status">Active</span>
                    }
                    else
                    {
                <span class="status inactive-status">Inactive</span>
                    }

            </div>

            <hr />

            <div class="row mt-4">

                <div class="col-md-6">
                    <p class="detail-label">Society ID</p>
                    <p class="detail-value">@Model.SocietyId</p>
                </div>

                <div class="col-md-6">
                    <p class="detail-label">Society Name</p>
                    <p class="detail-value">@Model.Name</p>
                </div>

                <div class="col-md-6">
                    <p class="detail-label">Address</p>
                    <p class="detail-value">@Model.Address</p>
                </div>

                <div class="col-md-6">
                    <p class="detail-label">City</p>
                    <p class="detail-value">@Model.City</p>
                </div>

                <div class="col-md-6">
                    <p class="detail-label">State</p>
                    <p class="detail-value">@Model.State</p>
                </div>

                <div class="col-md-6">
                    <p class="detail-label">Pincode</p>
                    <p class="detail-value">@Model.Pincode</p>
                </div>

                <div class="col-md-6">
                    <p class="detail-label">Created At</p>
                    <p class="detail-value">
                        @Model.CreatedAt.ToString("dd MMM yyyy")
                    </p>
                </div>

            </div>

        </div>
        }

    </main>

    <script>function confirmStatusChange(isCurrentlyActive) {
            if (isCurrentlyActive) {
                return confirm(
                    "Are you sure you want to deactivate this society?"
                );
            }

            return confirm(
                "Are you sure you want to activate this society?"
            );
        }</script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
