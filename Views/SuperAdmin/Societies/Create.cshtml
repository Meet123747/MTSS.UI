
@{
    ViewData["Title"] = "Add Society";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>MTSS | Add Society</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <style>
        body {
            background: #f4f6fa;
            font-family: Arial, sans-serif;
            margin: 0;
        }

        .sidebar {
            width: 250px;
            min-height: 100vh;
            position: fixed;
            background: #17243a;
            color: white;
            padding: 25px 18px;
        
            display: flex;
            flex-direction: column;
}

        .brand {
            font-size: 25px;
            font-weight: bold;
            margin-bottom: 40px;
        }

        .nav-link {
            color: #cbd5e1;
            padding: 12px 15px;
            margin-bottom: 8px;
            border-radius: 7px;
        }

            .nav-link:hover,
            .nav-link.active {
                background: #2563eb;
                color: white;
            }

        .main-content {
            margin-left: 250px;
            padding: 30px;
        }

        .form-card {
            background: white;
            border-radius: 12px;
            padding: 30px;
            box-shadow: 0 3px 15px rgba(0,0,0,0.04);
            max-width: 1000px;
        }

        .form-label {
            font-weight: 600;
            color: #334155;
        }

        .form-control {
            padding: 11px;
            border-radius: 7px;
        }

        .btn-primary {
            background: #2563eb;
            border-color: #2563eb;
        }

        .section-title {
            font-size: 17px;
            font-weight: 600;
            margin-bottom: 20px;
            color: #17243a;
        }

        @@media (max-width: 768px) {
            .sidebar {
                width: 100%;
                min-height: auto;
                position: relative;
            }

            .main-content {
                margin-left: 0;
                padding: 18px;
            }
        }
    
        .sidebar-bottom {
            margin-top: auto;
            padding-top: 16px;
        }

        .logout-link {
            display: block;
            width: 100%;
            text-align: left;
            color: #fca5a5;
            background: transparent;
            border: 0;
            border-radius: 7px;
            padding: 12px 15px;
            margin-bottom: 8px;
            cursor: pointer;
            font: inherit;
            text-decoration: none;
            transition: background-color 0.2s ease, color 0.2s ease;
        }

        .logout-link:hover,
        .logout-link:focus {
            background: #dc2626;
            color: #ffffff;
        }

    </style>
</head>

<body>

    <aside class="sidebar">
        <div class="brand">MTSS</div>

        <p class="text-uppercase text-secondary small">
            Main Menu
        </p>

        <nav class="nav flex-column">
            <a class="nav-link"
               href="/SuperAdmin/Index">
                Dashboard
            </a>

            <a class="nav-link active"
               href="/SuperAdmin/Societies">
                Societies
            </a>

            <a class="nav-link" href="#">
                Subscription Plans
            </a>

            <a class="nav-link" href="#">
                Payments
            </a>

            <a class="nav-link" href="#">
                Reports
            </a>

            <a class="nav-link" href="#">
                Settings
            </a>
        </nav>
    
        <div class="sidebar-bottom">
            <form asp-controller="Auth" asp-action="Logout" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="logout-link">
                    Logout
                </button>
            </form>
        </div>

    </aside>

    <main class="main-content">

        <div class="mb-4">
            <h2 class="fw-semibold">Add New Society</h2>
            <p class="text-secondary">
                Enter the details to register a new society
            </p>
        </div>

        <div class="form-card">

            <form asp-controller="SuperAdmin"
                  asp-action="CreateSociety"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <h5 class="section-title">
                    Basic Information
                </h5>

                <div class="row g-3">

                    <div class="col-md-6">
                        <label class="form-label">
                            Society Name *
                        </label>

                        <input type="text"
                               class="form-control"
                               name="Name"
                               placeholder="Enter society name"
                               required />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">
                            Society Address *
                        </label>

                        <input type="text"
                               class="form-control"
                               name="Address"
                               placeholder="Enter complete address"
                               required />
                    </div>

                </div>

                <hr class="my-4" />

                <h5 class="section-title">
                    Location Information
                </h5>

                <div class="row g-3">

                    <div class="col-md-4">
                        <label class="form-label">City *</label>

                        <input type="text"
                               class="form-control"
                               name="City"
                               placeholder="Enter city"
                               required />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">State *</label>

                        <input type="text"
                               class="form-control"
                               name="State"
                               placeholder="Enter state"
                               required />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Pincode *</label>

                        <input type="text"
                               class="form-control"
                               name="Pincode"
                               placeholder="Enter 6-digit pincode"
                               pattern="[0-9]{6}"
                               maxlength="6"
                               required />
                    </div>

                </div>

                <hr class="my-4" />

                <div class="d-flex justify-content-end gap-2">

                    <a href="/SuperAdmin/Societies"
                       class="btn btn-outline-secondary px-4">
                        Cancel
                    </a>

                    <button type="submit"
                            class="btn btn-primary px-4">
                        Save Society
                    </button>

                </div>

                @if (ViewBag.ErrorMessage != null)
                {
                <div class="alert alert-danger mt-3">
                    @ViewBag.ErrorMessage
                </div>
                }

            </form>

        </div>

    </main>

</body>
</html>
