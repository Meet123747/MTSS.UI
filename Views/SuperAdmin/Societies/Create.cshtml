
@{
    ViewData["Title"] = "Add Society";
    Layout = "_SuperAdminLayout";
}



        <div class="mb-4">
            <h2 class="fw-semibold">Add New Society</h2>
            <p class="text-secondary">
                Enter the details to register a new society
            </p>
        </div>

        <div class="form-card">

            <form asp-controller="SuperAdmin"
                  asp-action="CreateSociety"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <h5 class="section-title">
                    Basic Information
                </h5>

                <div class="row g-3">

                    <div class="col-md-6">
                        <label class="form-label">
                            Society Name *
                        </label>

                        <input type="text"
                               class="form-control"
                               name="Name"
                               placeholder="Enter society name"
                               required />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">
                            Society Address *
                        </label>

                        <input type="text"
                               class="form-control"
                               name="Address"
                               placeholder="Enter complete address"
                               required />
                    </div>

                </div>

                <hr class="my-4" />

                <h5 class="section-title">
                    Location Information
                </h5>

                <div class="row g-3">

                    <div class="col-md-4">
                        <label class="form-label">City *</label>

                        <input type="text"
                               class="form-control"
                               name="City"
                               placeholder="Enter city"
                               required />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">State *</label>

                        <input type="text"
                               class="form-control"
                               name="State"
                               placeholder="Enter state"
                               required />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Pincode *</label>

                        <input type="text"
                               class="form-control"
                               name="Pincode"
                               placeholder="Enter 6-digit pincode"
                               pattern="[0-9]{6}"
                               maxlength="6"
                               required />
                    </div>

                </div>

                <hr class="my-4" />

                <div class="d-flex justify-content-end gap-2">

                    <a href="/SuperAdmin/Societies"
                       class="btn btn-outline-secondary px-4">
                        Cancel
                    </a>

                    <button type="submit"
                            class="btn btn-primary px-4">
                        Save Society
                    </button>

                </div>

                @if (ViewBag.ErrorMessage != null)
                {
                <div class="alert alert-danger mt-3">
                    @ViewBag.ErrorMessage
                </div>
                }

            </form>

        </div>
