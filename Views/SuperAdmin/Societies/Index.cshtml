
@model List<MTSS.UI.Models.ApiModels.Societies.SocietyListItem>

    @{
    ViewData["Title"] = "Society Management";
    Layout = null;

    var totalSocieties = Model?.Count ?? 0;
    var activeSocieties = Model?.Count(s => s.IsActive) ?? 0;
    var inactiveSocieties = totalSocieties - activeSocieties;
    }

    <!DOCTYPE html>
    <html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />

        <title>MTSS | Society Management</title>

        <link rel="stylesheet"
              href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

        <style>
            body {
                margin: 0;
                background: #f4f6fa;
                font-family: Arial, sans-serif;
            }

            .sidebar {
                width: 250px;
                min-height: 100vh;
                background: #17243a;
                color: white;
                position: fixed;
                padding: 25px 18px;
            
            display: flex;
            flex-direction: column;
}

            .brand {
                font-size: 25px;
                font-weight: bold;
                margin-bottom: 40px;
            }

            .nav-link {
                color: #cbd5e1;
                padding: 12px 15px;
                margin-bottom: 8px;
                border-radius: 7px;
            }

                .nav-link.active,
                .nav-link:hover {
                    background: #2563eb;
                    color: white;
                }

            .main-content {
                margin-left: 250px;
                padding: 30px;
            }

            .content-card {
                background: white;
                border: none;
                border-radius: 12px;
                padding: 24px;
                box-shadow: 0 3px 15px rgba(0,0,0,0.04);
            }

            .btn-primary {
                background: #2563eb;
                border-color: #2563eb;
            }

            .search-box {
                max-width: 350px;
            }

            .table th {
                background: #f8fafc;
                color: #64748b;
                font-size: 13px;
                font-weight: 600;
                padding: 15px;
                white-space: nowrap;
            }

            .table td {
                padding: 17px 15px;
                vertical-align: middle;
            }

            .status {
                padding: 6px 12px;
                border-radius: 20px;
                font-size: 12px;
                font-weight: 600;
            }

            .active-status {
                background: #dcfce7;
                color: #15803d;
            }

            .inactive-status {
                background: #fee2e2;
                color: #b91c1c;
            }

            .page-title {
                font-weight: 600;
            }

            .action-btn {
                white-space: nowrap;
            }

            @@media (max-width: 768px) {
                .sidebar {
                    width: 100%;
                    min-height: auto;
                    position: relative;
                }

                .main-content {
                    margin-left: 0;
                    padding: 18px;
                }
            }
        
        .sidebar-bottom {
            margin-top: auto;
            padding-top: 16px;
        }

        .logout-link {
            display: block;
            width: 100%;
            text-align: left;
            color: #fca5a5;
            background: transparent;
            border: 0;
            border-radius: 7px;
            padding: 12px 15px;
            margin-bottom: 8px;
            cursor: pointer;
            font: inherit;
            text-decoration: none;
            transition: background-color 0.2s ease, color 0.2s ease;
        }

        .logout-link:hover,
        .logout-link:focus {
            background: #dc2626;
            color: #ffffff;
        }

    </style>
    </head>

    <body>

        <!-- Sidebar -->
        <aside class="sidebar">

            <div class="brand">MTSS</div>

            <p class="text-uppercase text-secondary small">
                Main Menu
            </p>

            <nav class="nav flex-column">

                <a class="nav-link"
                   href="@Url.Action("Index", "SuperAdmin")">
                    Dashboard
                </a>
                <a class="nav-link active"
                   asp-controller="SuperAdmin"
                   asp-action="Societies">
                    Societies
                </a>

                <!-- Fixed Subscription Plans Navigation -->
                <a class="nav-link"
                   href="@Url.Action("SubscriptionPlans", "SuperAdmin")">
                    Subscription Plans
                </a>

                <a class="nav-link" href="#">
                    Payments
                </a>

                <a class="nav-link" href="#">
                    Reports
                </a>

                <a class="nav-link" href="#">
                    Settings
                </a>

            </nav>

        
        <div class="sidebar-bottom">
            <form asp-controller="Auth" asp-action="Logout" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="logout-link">
                    Logout
                </button>
            </form>
        </div>

    </aside>

        <!-- Main Content -->
        <main class="main-content">

            <div class="d-flex justify-content-between
                    align-items-center flex-wrap gap-3 mb-4">

                <div>
                    <h2 class="page-title">Society Management</h2>

                    <p class="text-secondary mb-0">
                        Manage and monitor registered societies
                    </p>
                </div>

                <a asp-controller="SuperAdmin"
                   asp-action="CreateSociety"
                   class="btn btn-primary px-4">
                    + Add Society
                </a>

            </div>

            @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show">
                @TempData["SuccessMessage"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert">
                </button>
            </div>
        }

            @if (ViewBag.ErrorMessage != null)
        {
            <div class="alert alert-danger">
                @ViewBag.ErrorMessage
            </div>
        }

            <!-- Summary Cards -->
            <div class="row g-4 mb-4">

                <div class="col-md-4">
                    <div class="content-card">
                        <p class="text-secondary mb-2">
                            Total Societies
                        </p>
                        <h3>@totalSocieties</h3>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="content-card">
                        <p class="text-secondary mb-2">
                            Active Societies
                        </p>
                        <h3>@activeSocieties</h3>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="content-card">
                        <p class="text-secondary mb-2">
                            Inactive Societies
                        </p>
                        <h3>@inactiveSocieties</h3>
                    </div>
                </div>

            </div>

            <!-- Society Table -->
            <div class="content-card">

                <div class="d-flex justify-content-between
                        align-items-center flex-wrap gap-3 mb-4">

                    <h5 class="mb-0">All Societies</h5>

                    <input type="text"
                           id="societySearch"
                           class="form-control search-box"
                           placeholder="Search societies..." />

                </div>

                <div class="table-responsive">

                    <table class="table table-hover"
                           id="societyTable">

                        <thead>
                            <tr>
                                <th>Society Name</th>
                                <th>Location</th>
                                <th>Total Wings</th>
                                <th>Residents</th>
                                <th>Status</th>
                                <th>Created At</th>
                                <th>Actions</th>
                            </tr>
                        </thead>

                        <tbody>

                            @if (Model != null && Model.Any())
                        {
                            foreach (var society in Model)
                            {
                            <tr>
                                <td>
                                    <strong>@society.Name</strong>

                                    <div class="text-secondary small">
                                        ID: @society.SocietyId
                                    </div>
                                </td>

                                <td>
                                    @society.Address,
                                    @society.City,
                                    @society.State -
                                    @society.Pincode
                                </td>

                                <td>—</td>

                                <td>—</td>

                                <td>
                                    @if (society.IsActive)
                                        {
                                    <span class="status active-status">
                                        Active
                                    </span>
                                        }
                                        else
                                        {
                                    <span class="status inactive-status">
                                        Inactive
                                    </span>
                                        }
                                </td>

                                <td>
                                    @society.CreatedAt.ToString("dd MMM yyyy")
                                </td>

                                <td>
                                    <a asp-controller="SuperAdmin"
                                       asp-action="SocietyDetails"
                                       asp-route-id="@society.SocietyId"
                                       class="btn btn-sm btn-outline-primary action-btn">
                                        View Details
                                    </a>
                                </td>
                            </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7"
                                    class="text-center text-secondary py-5">
                                    No societies found.
                                </td>
                            </tr>
                        }

                        </tbody>

                    </table>

                </div>

            </div>

        </main>

        <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

        <script>
            document.getElementById("societySearch")
                .addEventListener("input", function () {

                    const searchValue = this.value.toLowerCase();

                    document.querySelectorAll("#societyTable tbody tr")
                        .forEach(row => {
                            row.style.display =
                                row.innerText.toLowerCase()
                                    .includes(searchValue) ? "" : "none";
                        });
                });
        </script>

    </body>
</html>
