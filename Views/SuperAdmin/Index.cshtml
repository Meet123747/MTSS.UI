
@{
    ViewData["Title"] = "SuperAdmin Dashboard";
    Layout = "_SuperAdminLayout";
}



        <!-- Page Header -->
        <div class="mb-4">

            <h2 class="page-title">SuperAdmin Dashboard</h2>

            <p class="text-secondary mb-0">
                Overview of your MTSS platform and management activities.
            </p>

        </div>

        <!-- Welcome Section -->
        <div class="welcome-card">

            <h4 class="mb-2">Welcome to MTSS!</h4>

            <p>
                Manage societies, subscription plans and platform operations
                from one central dashboard.
            </p>

        </div>

        <!-- Summary Cards -->
        <div class="row g-4 mb-4">

            <div class="col-md-6 col-xl-3">
                <div class="content-card">
                    <p class="summary-label">Total Societies</p>
                    <h3 class="summary-value">@ViewBag.TotalSocieties</h3>
                    <small class="text-secondary">
                        Registered societies
                    </small>
                </div>
            </div>

            <div class="col-md-6 col-xl-3">
                <div class="content-card">
                    <p class="summary-label">Active Societies</p>
                    <h3 class="summary-value">@ViewBag.ActiveSocieties</h3>
                    <small class="text-secondary">
                        Currently active
                    </small>
                </div>
            </div>

            <div class="col-md-6 col-xl-3">
                <div class="content-card">
                    <p class="summary-label">Total Subscription Plans</p>
                    <h3 class="summary-value">@ViewBag.TotalPlans</h3>
                    <small class="text-secondary">
                        Available plans
                    </small>
                </div>
            </div>

            <div class="col-md-6 col-xl-3">
                <div class="content-card">
                    <p class="summary-label">Active Subscription Plans</p>
                    <h3 class="summary-value">@ViewBag.ActivePlans</h3>
                    <small class="text-secondary">
                        Currently active
                    </small>
                </div>
            </div>

        </div>

        <!-- Quick Management -->
        <div class="content-card mb-4">

            <h5 class="section-title">Quick Management</h5>

            <div class="row g-3">

                <div class="col-md-6 col-xl-4">
                    <a class="quick-link"
                       href="@Url.Action("Societies", "SuperAdmin")">
                        <span class="quick-link-icon"><span data-icon="building"></span></span>
                        <h6>Society Management →</h6>

                        <p>
                            Create, view, update and manage societies.
                        </p>

                    </a>
                </div>

                <div class="col-md-6 col-xl-4">
                    <a class="quick-link"
                       href="@Url.Action("SubscriptionPlans", "SuperAdmin")">
                        <span class="quick-link-icon"><span data-icon="layers"></span></span>
                        <h6>Subscription Plans →</h6>

                        <p>
                            Manage subscription plans and feature limits.
                        </p>

                    </a>
                </div>

                <div class="col-md-6 col-xl-4">
                    <a class="quick-link"
                       href="@Url.Action("Payments", "SuperAdmin")">
                        <span class="quick-link-icon"><span data-icon="creditCard"></span></span>
                        <h6>Payments →</h6>

                        <p>
                            Monitor society subscription payments.
                        </p>

                    </a>
                </div>

                <div class="col-md-6 col-xl-4">
                    <a class="quick-link"
                       href="@Url.Action("Reports", "SuperAdmin")">
                        <span class="quick-link-icon"><span data-icon="chart"></span></span>
                        <h6>Reports →</h6>

                        <p>
                            View platform reports and statistics.
                        </p>

                    </a>
                </div>

                <div class="col-md-6 col-xl-4">
                    <a class="quick-link"
                       href="@Url.Action("Settings", "SuperAdmin")">
                        <span class="quick-link-icon"><span data-icon="settings"></span></span>
                        <h6>Settings →</h6>

                        <p>
                            Manage platform configuration.
                        </p>


                    </a>
                </div>
                

            </div>

        </div>

        <!-- Platform Information -->
        <div class="content-card">

            <h5 class="section-title">Platform Information</h5>

            <div class="row">

                <div class="col-md-6 mb-3">
                    <p class="text-secondary mb-1">Platform Name</p>
                    <h6>MTSS - Management System</h6>
                </div>

                <div class="col-md-6 mb-3">
                    <p class="text-secondary mb-1">User Role</p>
                    <h6>Super Administrator</h6>
                </div>

                <div class="col-md-6 mb-3">
                    <p class="text-secondary mb-1">Platform Status</p>
                    <span class="badge bg-success">Operational</span>
                </div>

                <div class="col-md-6 mb-3">
                    <p class="text-secondary mb-1">Application Version</p>
                    <h6>MTSS UI - .NET 8</h6>
                </div>

            </div>

        </div>

        <!-- Recent Society Registrations -->
        <div class="content-card mb-4">

            <div class="d-flex justify-content-between
                align-items-center flex-wrap gap-3 mb-4">

                <h5 class="section-title mb-0">
                    Recent Society Registrations
                </h5>

                <a href="@Url.Action("Societies", "SuperAdmin")"
                   class="btn btn-outline-primary btn-sm">
                    View All Societies
                </a>

            </div>

            @{
                var recentSocieties =
                    ViewBag.RecentSocieties as
                    List<MTSS.UI.Models.ApiModels.Societies.SocietyListItem>
                    ?? new List<MTSS.UI.Models.ApiModels.Societies.SocietyListItem>();
            }

            <div class="table-responsive">

                <table class="table table-hover sup-data-table">

                    <thead>
                        <tr>
                            <th>Society Name</th>
                            <th>City</th>
                            <th>Registration Date</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (recentSocieties.Any())
                        {
                        @foreach (var society in recentSocieties)
                            {
                        <tr>
                            <td data-label="Society name">
                                <strong>@society.Name</strong>
                            </td>

                            <td data-label="City">@society.City</td>

                            <td data-label="Registration date">
                                @society.CreatedAt.ToString("dd MMM yyyy")
                            </td>

                            <td data-label="Status">
                                @if (society.IsActive)
                                        {
                                <span class="status active-status">
                                    Active
                                </span>
                                        }
                                        else
                                        {
                                <span class="status inactive-status">
                                    Inactive
                                </span>
                                        }
                            </td>

                            <td data-label="Action">
                                <a href="@Url.Action(
                                            "SocietyDetails",
                                            "SuperAdmin",
                                            new { id = society.SocietyId })"
                                   class="btn btn-sm btn-outline-primary">
                                    View Details
                                </a>
                            </td>
                        </tr>
                            }
                        }
                        else
                        {
                        <tr>
                            <td colspan="5"
                                class="text-center text-secondary py-4">
                                No society registrations found.
                            </td>
                        </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
