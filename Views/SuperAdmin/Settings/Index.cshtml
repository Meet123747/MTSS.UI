
@{
    ViewData["Title"] = "Settings";
    Layout = "_SuperAdminLayout";
}



        <div class="mb-4">
            <h2 class="fw-semibold mb-1">Settings</h2>
            <p class="text-secondary mb-0">
                Manage your SuperAdmin account and platform information.
            </p>
        </div>

        <div class="settings-card">
            <div class="d-flex align-items-center gap-3 mb-3">
                <div class="info-icon"><span data-icon="user"></span></div>
                <div>
                    <h5 class="mb-1">Account Information</h5>
                    <p class="text-secondary small mb-0">
                        Your current administrator session information.
                    </p>
                </div>
            </div>

            <div class="setting-row">
                <div class="setting-label">Account Role</div>
                <div class="setting-value">SuperAdmin</div>
            </div>

            <div class="setting-row">
                <div class="setting-label">Account Status</div>
                <div><span class="status-badge">Active Session</span></div>
            </div>
        </div>

        <div class="settings-card">
            <div class="d-flex align-items-center gap-3 mb-3">
                <div class="info-icon"><span data-icon="settings"></span></div>
                <div>
                    <h5 class="mb-1">Platform Information</h5>
                    <p class="text-secondary small mb-0">
                        Basic information about the MTSS platform.
                    </p>
                </div>
            </div>

            <div class="setting-row">
                <div class="setting-label">Platform Name</div>
                <div class="setting-value">MTSS - Multi-Tenant Society System</div>
            </div>

            <div class="setting-row">
                <div class="setting-label">Application</div>
                <div class="setting-value">MTSS.UI</div>
            </div>

            <div class="setting-row">
                <div class="setting-label">User Panel</div>
                <div class="setting-value">Super Administrator Panel</div>
            </div>
        </div>

        <div class="settings-card">
            <div class="d-flex align-items-center gap-3 mb-3">
                <div class="info-icon"><span data-icon="shield"></span></div>
                <div>
                    <h5 class="mb-1">Security</h5>
                    <p class="text-secondary small mb-0">
                        Account session and security options.
                    </p>
                </div>
            </div>

            <div class="setting-row">
                <div class="setting-label">Authentication</div>
                <div class="setting-value">Backend Identity Authentication</div>
            </div>

            <div class="setting-row">
                <div class="setting-label">Session</div>
                <div class="setting-value">Authenticated session</div>
            </div>

            <div class="setting-row d-flex justify-content-between align-items-center flex-wrap gap-3">
                <div>
                    <div class="setting-label">Sign Out</div>
                    <div class="setting-value">End your current administrator session.</div>
                </div>
            </div>
        </div>

        <div class="text-secondary small text-center mt-4">
            MTSS Administration Panel
        </div>
