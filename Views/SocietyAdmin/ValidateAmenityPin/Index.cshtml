
@using System.Text.Json
@{
    Layout = "_SocietyAdminLayout";
    ViewData["Title"] = "Amenity PIN Gate";

    var amenities = ViewBag.Amenities as List<JsonElement> ?? new();

    // Supports a preselected amenity passed by the controller or URL:
    // /SocietyAdminModules/ValidateAmenityPin?amenityId=1
    var selectedId =
        ViewBag.SelectedAmenityId?.ToString()
        ?? Context.Request.Query["amenityId"].ToString();

    string Prop(JsonElement el, params string[] keys)
    {
        if (el.ValueKind != JsonValueKind.Object) return "";

        foreach (var key in keys)
        {
            if (el.TryGetProperty(key, out var value) &&
                value.ValueKind != JsonValueKind.Null)
                return value.ToString();
        }

        return "";
    }

    // Automatically select the only available amenity.
    if (string.IsNullOrWhiteSpace(selectedId) && amenities.Count == 1)
    {
        selectedId = Prop(amenities[0], "amenityId", "id");
    }

    bool? accessGranted = ViewBag.AccessGranted as bool?;
    var validationMessage = ViewBag.ValidationMessage?.ToString();
    var errorMessage = ViewBag.ErrorMessage?.ToString();
}

<style>
    .pin-gate {
        max-width: 760px;
        margin: 0 auto;
        padding: 12px;
    }

    .pin-gate-card {
        background: var(--bs-body-bg, #fff);
        border: 1px solid var(--bs-border-color, #e5e7eb);
        border-radius: 22px;
        padding: clamp(22px, 5vw, 42px);
        text-align: center;
        box-shadow: 0 12px 35px rgba(0,0,0,.06);
    }

    .pin-gate-heading {
        font-size: clamp(25px, 4vw, 38px);
        font-weight: 800;
        margin-bottom: 8px;
    }

    .pin-gate-subtitle {
        color: var(--bs-secondary-color, #777);
        margin-bottom: 28px;
    }

    .pin-amenity-select {
        max-width: 460px;
        margin: 0 auto 26px;
        text-align: left;
    }

    .pin-input {
        width: 100%;
        max-width: 460px;
        margin: 10px auto 20px;
        display: block;
        text-align: center;
        font-size: clamp(34px, 7vw, 52px);
        font-weight: 800;
        letter-spacing: .32em;
        padding: 16px 12px 16px 24px;
        border: 2px solid var(--bs-border-color, #ddd);
        border-radius: 16px;
        font-variant-numeric: tabular-nums;
    }

    .pin-input:focus {
        border-color: var(--bs-primary, #2563eb);
        outline: none;
        box-shadow: 0 0 0 4px rgba(37,99,235,.12);
    }

    .pin-hint {
        color: var(--bs-secondary-color, #777);
        font-size: 14px;
    }

    .pin-result {
        margin-top: 26px;
        padding: 25px 16px;
        border-radius: 18px;
        font-weight: 800;
    }

    .pin-result.allowed {
        background: #dcfce7;
        color: #166534;
        border: 2px solid #86efac;
    }

    .pin-result.denied {
        background: #fee2e2;
        color: #991b1b;
        border: 2px solid #fca5a5;
    }

    .pin-result h2 {
        font-size: clamp(26px, 5vw, 42px);
        font-weight: 900;
        margin: 8px 0;
    }

    .pin-result p {
        margin: 0;
        font-size: 16px;
        font-weight: 500;
    }

    .pin-result-icon {
        font-size: 46px;
        line-height: 1.2;
    }

    .pin-gate-actions {
        display: flex;
        justify-content: center;
        gap: 12px;
        flex-wrap: wrap;
        margin-bottom: 18px;
    }

    .pin-fullscreen-btn {
        border-radius: 12px;
        padding: 11px 18px;
        font-weight: 700;
    }

    .pin-submit-status {
        display: none;
        margin-top: 18px;
        color: var(--bs-secondary-color, #777);
        font-weight: 600;
    }

    .pin-submit-status.visible {
        display: block;
    }

    .pin-spinner {
        display: inline-block;
        width: 17px;
        height: 17px;
        border: 2px solid currentColor;
        border-right-color: transparent;
        border-radius: 50%;
        animation: pin-spin .7s linear infinite;
        vertical-align: -3px;
        margin-right: 8px;
    }

    @@keyframes pin-spin {
        to { transform: rotate(360deg); }
    }

    /* Full-screen gate mode */
    .pin-gate.kiosk-mode {
        position: fixed;
        inset: 0;
        z-index: 99999;
        width: 100%;
        max-width: none;
        height: 100vh;
        height: 100dvh;
        overflow-y: auto;
        margin: 0;
        padding: clamp(12px, 4vw, 40px);
        background: var(--bs-body-bg, #f8fafc);
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .pin-gate.kiosk-mode .pin-gate-card {
        width: 100%;
        max-width: 850px;
        margin: auto;
        padding: clamp(24px, 6vw, 60px);
        box-shadow: 0 18px 55px rgba(0,0,0,.12);
    }

    .pin-gate.kiosk-mode .pin-input {
        max-width: 520px;
        font-size: clamp(42px, 8vw, 68px);
    }

    .pin-gate.kiosk-mode .pin-gate-heading {
        font-size: clamp(32px, 5vw, 48px);
    }

    /* Hide the normal admin interface when browser fullscreen is active */
    body:has(#pinGate:fullscreen) {
        overflow: hidden;
    }

    #pinGate:fullscreen {
        background: var(--bs-body-bg, #f8fafc);
        width: 100%;
        height: 100%;
        max-width: none;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 30px;
    }

    #pinGate:fullscreen .pin-gate-card {
        width: 100%;
        max-width: 850px;
        margin: auto;
    }

    @@media (max-width: 576px) {
        .pin-gate {
            padding: 4px;
        }

        .pin-gate-card {
            border-radius: 16px;
            padding: 22px 16px;
        }

        .pin-input {
            letter-spacing: .2em;
            padding-left: 16px;
        }
    }
</style>

<div class="pin-gate" id="pinGate">
    <div class="pin-gate-actions">
        <button type="button"
                class="btn btn-outline-primary pin-fullscreen-btn"
                id="fullscreenButton">
            ⛶ Full Screen
        </button>
    </div>

    <div class="pin-gate-card">
        <div class="mb-3">
            <span style="font-size: clamp(38px, 6vw, 56px);">🔐</span>
        </div>

        <h1 class="pin-gate-heading">Amenity Access</h1>
        <p class="pin-gate-subtitle">
            Enter the resident's six-digit PIN to verify access.
        </p>

        <form asp-action="ValidateAmenityPin"
              method="post"
              id="pinValidationForm"
              autocomplete="off">

            @Html.AntiForgeryToken()

            <div class="pin-amenity-select">
                <label class="form-label fw-bold" for="amenityId">
                    Select Amenity
                </label>

                <select id="amenityId"
                        name="amenityId"
                        class="form-select form-select-lg"
                        required>
                    <option value="">Choose an amenity</option>

                    @foreach (var amenity in amenities)
                    {
                        var amenityId = Prop(amenity, "amenityId", "id");
                        var amenityName = Prop(amenity, "name", "amenityName");

                        <option value="@amenityId"
                                selected="@(selectedId == amenityId ? "selected" : null)">
                            @amenityName
                        </option>
                    }
                </select>
            </div>

            <label class="form-label fw-bold" for="pin">
                Enter Access PIN
            </label>

            <input type="text"
                   id="pin"
                   name="pin"
                   class="form-control pin-input"
                   placeholder="••••••"
                   inputmode="numeric"
                   pattern="[0-9]{6}"
                   maxlength="6"
                   minlength="6"
                   autocomplete="off"
                   autocorrect="off"
                   spellcheck="false"
                   required />

            <div class="pin-hint" id="pinHint">
                Validation starts automatically after all 6 digits are entered.
            </div>

            <div class="pin-submit-status" id="pinSubmitStatus" aria-live="polite">
                <span class="pin-spinner"></span>
                Checking PIN...
            </div>
        </form>

        @if (accessGranted == true)
        {
            <div class="pin-result allowed" role="status">
                <div class="pin-result-icon">✓</div>
                <h2>ACCESS ALLOWED</h2>
                <p>@(validationMessage ?? "The PIN is valid. Access is permitted.")</p>
            </div>
        }
        else if (accessGranted == false)
        {
            <div class="pin-result denied" role="alert">
                <div class="pin-result-icon">✕</div>
                <h2>ACCESS DENIED</h2>
                <p>@(validationMessage ?? "The PIN is invalid, expired, or already used.")</p>
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-danger mt-4" role="alert">
                @errorMessage
            </div>
        }
    </div>
</div>

<script>
    (() => {
        const gate = document.getElementById("pinGate");
        const form = document.getElementById("pinValidationForm");
        const pinInput = document.getElementById("pin");
        const amenitySelect = document.getElementById("amenityId");
        const submitStatus = document.getElementById("pinSubmitStatus");
        const fullscreenButton = document.getElementById("fullscreenButton");

        if (!gate || !form || !pinInput || !amenitySelect) return;

        let submitting = false;

        // Keep only digits and validate automatically at exactly six digits.
        pinInput.addEventListener("input", () => {
            pinInput.value = pinInput.value.replace(/\D/g, "").slice(0, 6);

            if (pinInput.value.length === 6) {
                if (!amenitySelect.value) {
                    pinInput.setCustomValidity("Please select an amenity first.");
                    pinInput.reportValidity();
                    pinInput.setCustomValidity("");
                    amenitySelect.focus();
                    return;
                }

                if (!submitting) {
                    submitting = true;
                    submitStatus?.classList.add("visible");
                    pinInput.readOnly = true;
                    amenitySelect.disabled = true;
                    form.requestSubmit();
                }
            }
        });

        // Fullscreen API, with a CSS kiosk-mode fallback for devices
        // whose browser does not support fullscreen.
        fullscreenButton?.addEventListener("click", async () => {
            try {
                if (document.fullscreenElement) {
                    await document.exitFullscreen();
                    gate.classList.remove("kiosk-mode");
                    fullscreenButton.textContent = "⛶ Full Screen";
                    return;
                }

                if (gate.requestFullscreen) {
                    await gate.requestFullscreen();
                } else {
                    gate.classList.add("kiosk-mode");
                }

                fullscreenButton.textContent = "✕ Exit Full Screen";
            } catch {
                gate.classList.toggle("kiosk-mode");
                fullscreenButton.textContent =
                    gate.classList.contains("kiosk-mode")
                        ? "✕ Exit Full Screen"
                        : "⛶ Full Screen";
            }
        });

        document.addEventListener("fullscreenchange", () => {
            const active = document.fullscreenElement === gate;
            fullscreenButton.textContent = active
                ? "✕ Exit Full Screen"
                : "⛶ Full Screen";
        });

        // Focus PIN field when the gate opens, provided an amenity is selected.
        if (amenitySelect.value) {
            pinInput.focus();
        }
    })();
</script>
