@using System.Text.Json
@{
    ViewData["Title"] = ViewBag.Title ?? "Society Management";
    var module = (string)ViewBag.Module;
    var rows = ViewBag.Rows as List<JsonElement> ?? new();
    var fields = ViewBag.Fields as string[] ?? Array.Empty<string>();
    var labels = ViewBag.Labels as string[] ?? Array.Empty<string>();
    var allowEdit = ViewBag.AllowEdit is bool ae && ae;

    var wings = ViewBag.Wings as List<JsonElement> ?? new();
    var floors = ViewBag.Floors as List<JsonElement> ?? new();
    var flats = ViewBag.Flats as List<JsonElement> ?? new();
    var residents = ViewBag.Residents as List<JsonElement> ?? new();
    var amenities = ViewBag.Amenities as List<JsonElement> ?? new();

    string Prop(JsonElement row, params string[] keys)
    {
        if (row.ValueKind != JsonValueKind.Object) return "";
        foreach (var k in keys)
        {
            if (row.TryGetProperty(k, out var v) && v.ValueKind != JsonValueKind.Null)
                return v.ToString();
        }
        return "";
    }

    string Value(JsonElement row, string key)
    {
        var v = Prop(row, key);
        return string.IsNullOrEmpty(v) ? "—" : v;
    }

    var wingNames = wings.ToDictionary(w => Prop(w, "wingId", "id"), w => Prop(w, "name"));
    var floorNames = floors.ToDictionary(
        f => Prop(f, "floorId", "id"),
        f =>
        {
            var wName = Prop(f, "wingName");
            if (string.IsNullOrEmpty(wName)) wingNames.TryGetValue(Prop(f, "wingId"), out wName);
            var fName = Prop(f, "name");
            return string.IsNullOrEmpty(wName) ? fName : $"{wName} — {fName}";
        });
    var flatNames = flats.ToDictionary(
        fl => Prop(fl, "flatId", "id"),
        fl =>
        {
            var flNum = Prop(fl, "flatNumber");
            var fId = Prop(fl, "floorId");
            return floorNames.TryGetValue(fId, out var flLabel) && !string.IsNullOrEmpty(flLabel)
                ? $"{flLabel} — {flNum}"
                : flNum;
        });
    var residentNames = residents.ToDictionary(r => Prop(r, "residentProfileId", "id"), r => Prop(r, "fullName"));
    var amenityNames = amenities.ToDictionary(a => Prop(a, "amenityId", "id"), a => Prop(a, "name"));

    string DisplayField(JsonElement row, string f)
    {
        var raw = Prop(row, f);
        if (f == "wingId")
            return wingNames.GetValueOrDefault(raw) ?? (string.IsNullOrEmpty(raw) ? "—" : $"Wing #{raw}");
        if (f == "floorId")
            return floorNames.GetValueOrDefault(raw) ?? (string.IsNullOrEmpty(raw) ? "—" : $"Floor #{raw}");
        if (f == "flatId")
            return flatNames.GetValueOrDefault(raw) ?? (string.IsNullOrEmpty(raw) ? "—" : $"Flat #{raw}");
        if (f == "residentProfileId")
            return residentNames.GetValueOrDefault(raw) ?? (string.IsNullOrEmpty(raw) ? "—" : $"Resident #{raw}");
        if (f == "amenityId")
            return amenityNames.GetValueOrDefault(raw) ?? (string.IsNullOrEmpty(raw) ? "—" : $"Amenity #{raw}");
        if (f == "userId")
        {
            if (string.IsNullOrEmpty(raw)) return "General / All";
            var match = residents.FirstOrDefault(r => Prop(r, "applicationUserId", "userId") == raw);
            return match.ValueKind == JsonValueKind.Object ? Prop(match, "fullName") : raw;
        }
        return string.IsNullOrEmpty(raw) ? "—" : raw;
    }

    var isBooleanStatusModule = module is "wings" or "floors" or "flats" or "residents" or "amenities";
    var showWingFilter = (module is "floors" or "flats") && wings.Count > 0;
}

<div>
    <div class="mtss-page-header">
        <div>
            <div class="mtss-eyebrow">Society Administration</div>
            <h1 class="mtss-page-title">@ViewBag.Title</h1>
            <p class="mtss-page-subtitle">Manage records for your society.</p>
        </div>
        @if (fields.Length > 0)
        {
            <a class="btn btn-primary" asp-action="Create" asp-route-module="@module"><span data-icon="plus" class="mtss-icon-sm"></span> Add @ViewBag.Title</a>
        }
    </div>

    @if (TempData["Success"] != null) { <div class="alert alert-success mtss-alert">@TempData["Success"]</div> }
    @if (TempData["Error"] != null) { <div class="alert alert-danger mtss-alert">@TempData["Error"]</div> }
    @if (ViewBag.ErrorMessage != null) { <div class="alert alert-warning mtss-alert">@ViewBag.ErrorMessage</div> }

    <div class="mtss-card">
        <div class="mtss-toolbar">
            <h2 class="h6 fw-bold mb-0">Records <span class="badge text-bg-light ms-1">@rows.Count</span></h2>
            <div class="mtss-toolbar-controls">
                @if (showWingFilter)
                {
                    <select id="wingFilter" class="form-select sa-filter-select">
                        <option value="">All Wings</option>
                        @foreach (var w in wings)
                        {
                            <option value="@Prop(w, "name")">@Prop(w, "name")</option>
                        }
                    </select>
                }
                <input id="tableSearch" class="form-control sa-search-input" placeholder="Search records..." aria-label="Search records" />
            </div>
        </div>
        <div class="p-0">

            @if (rows.Count == 0)
            {
                <div class="sa-empty-state">
                    <span class="mtss-empty-icon"><span data-icon="inbox"></span></span>
                    <strong>No records found</strong>
                    <span>Create your first record if this module supports creation.</span>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle sa-data-table">
                        <thead>
                            <tr>
                                <th>Record</th>
                                @for (var i = 0; i < fields.Length; i++)
                                {
                                    <th>@(i < labels.Length ? labels[i] : fields[i])</th>
                                }
                                @if (module == "flats") { <th>Occupancy</th> }
                                @if (module == "residents") { <th>Presence</th> }
                                @if (module == "complaints") { <th>Subject</th><th>Description</th><th>Admin remarks</th> }
                                @if (module == "amenity-pins" || module == "amenity-logs") { <th>Amenity</th><th>Details</th> }
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="dataRows">
                            @foreach (var row in rows)
                            {
                                var id = new[] { "id", "wingId", "floorId", "flatId", "residentProfileId", "amenityId", "guestEntryId", "guestEntryRequestId", "parcelId", "complaintId", "notificationId", "amenityAccessLogId", "amenityAccessPinId" }
                                    .Select(k => Value(row, k)).FirstOrDefault(v => v != "—") ?? "—";
                                var isActive = Value(row, "isActive").Equals("True", StringComparison.OrdinalIgnoreCase);
                                var statusText = Value(row, "status");

                                <tr>
                                    <td class="fw-semibold sa-record-id" data-label="Record">#@id</td>
                                    @for (var i = 0; i < fields.Length; i++)
                                    {
                                        <td data-label="@(i < labels.Length ? labels[i] : fields[i])">@DisplayField(row, fields[i])</td>
                                    }

                                    @if (module == "flats")
                                    {
                                        var occupied = Value(row, "isOccupied").Equals("True", StringComparison.OrdinalIgnoreCase);
                                        <td data-label="Occupancy"><span class="badge rounded-pill @(occupied ? "text-bg-primary" : "text-bg-light")">@(occupied ? "Occupied" : "Vacant")</span></td>
                                    }
                                    @if (module == "residents")
                                    {
                                        var isHome = Value(row, "isHome").Equals("True", StringComparison.OrdinalIgnoreCase);
                                        <td data-label="Presence"><span class="badge rounded-pill @(isHome ? "text-bg-info" : "text-bg-secondary")">@(isHome ? "Home" : "Away")</span></td>
                                    }
                                    @if (module == "complaints")
                                    {
                                        <td data-label="Subject">@Value(row, "subject")</td>
                                        <td data-label="Description" class="small text-secondary">@Value(row, "description")</td>
                                        <td data-label="Admin remarks" class="small">@Value(row, "adminRemarks")</td>
                                    }
                                    @if (module == "amenity-pins" || module == "amenity-logs")
                                    {
                                        <td data-label="Amenity">@DisplayField(row, "amenityId")</td>
                                        <td data-label="Details" class="small">@(module == "amenity-pins" ? $"PIN: {Value(row, "pinCode")} | Expires: {Value(row, "expiresAt")}" : $"Accessed: {Value(row, "accessedAt")} | Valid: {Value(row, "isValid")}")</td>
                                    }

                                    <td data-label="Status">
                                        @if (isBooleanStatusModule)
                                        {
                                            <span class="badge rounded-pill @(isActive ? "text-bg-success" : "text-bg-secondary")">@(isActive ? "Active" : "Inactive")</span>
                                        }
                                        else
                                        {
                                            <span class="badge rounded-pill text-bg-light">@statusText</span>
                                        }
                                    </td>

                                    <td data-label="Actions">
                                        @if (module == "residents")
                                        {
                                            <div class="d-flex flex-column align-items-start gap-2 mb-2">
                                                <form asp-action="CreateResidentAccount" method="post" class="d-flex gap-1">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@id" />
                                                    <input name="email" type="email" class="form-control form-control-sm" placeholder="Login email" required style="max-width:140px" aria-label="Resident login email" />
                                                    <input name="password" type="password" class="form-control form-control-sm" placeholder="Temp password" required style="max-width:120px" aria-label="Temporary password" />
                                                    <button class="btn btn-sm btn-outline-success">Create login</button>
                                                </form>
                                                <form asp-action="LinkResidentAccount" method="post" class="d-flex gap-1">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@id" />
                                                    <input name="applicationUserId" type="text" class="form-control form-control-sm" placeholder="Existing User ID" required style="max-width:170px" aria-label="Existing user ID" />
                                                    <button class="btn btn-sm btn-outline-secondary">Link account</button>
                                                </form>
                                            </div>
                                        }

                                        @if (allowEdit && fields.Length > 0)
                                        {
                                            <a asp-action="Edit" asp-route-module="@module" asp-route-id="@id" class="btn btn-sm btn-outline-primary">Edit</a>
                                        }

                                        @if (module == "complaints")
                                        {
                                            <form asp-action="UpdateStatus" method="post" class="d-inline-flex flex-wrap gap-1">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="module" value="@module" />
                                                <input type="hidden" name="id" value="@id" />
                                                <select name="status" class="form-select form-select-sm">
                                                    @foreach (var s in new[] { "Open", "InProgress", "Resolved", "Approved", "Rejected" })
                                                    {
                                                        <option value="@s" selected="@(statusText.Equals(s, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@s</option>
                                                    }
                                                </select>
                                                <input name="adminRemarks" class="form-control form-control-sm" placeholder="Admin remarks" style="max-width:140px" />
                                                <button class="btn btn-sm btn-outline-primary">Update</button>
                                            </form>
                                        }
                                        else if (module == "guests")
                                        {
                                            <form asp-action="UpdateStatus" method="post" class="d-inline-flex flex-wrap gap-1">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="module" value="@module" />
                                                <input type="hidden" name="id" value="@id" />
                                                <select name="status" class="form-select form-select-sm">
                                                    <option value="Approved" selected="@(statusText.Equals("Approved", StringComparison.OrdinalIgnoreCase) ? "selected" : null)">Approved</option>
                                                    <option value="Rejected" selected="@(statusText.Equals("Rejected", StringComparison.OrdinalIgnoreCase) ? "selected" : null)">Rejected</option>
                                                </select>
                                                <button class="btn btn-sm btn-outline-primary">Update</button>
                                            </form>
                                        }
                                        else if (module == "parcels")
                                        {
                                            var isCollected = statusText.Equals("Collected", StringComparison.OrdinalIgnoreCase);
                                            <form asp-action="UpdateStatus" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="module" value="@module" />
                                                <input type="hidden" name="id" value="@id" />
                                                <input type="hidden" name="status" value="Collected" />
                                                <button class="btn btn-sm btn-outline-primary" disabled="@(isCollected ? "disabled" : null)">
                                                    @(isCollected ? "Collected" : "Mark Collected")
                                                </button>
                                            </form>
                                        }
                                        else if (isBooleanStatusModule)
                                        {
                                            <form asp-action="UpdateStatus" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="module" value="@module" />
                                                <input type="hidden" name="id" value="@id" />
                                                <input type="hidden" name="isActive" value="@(isActive ? "false" : "true")" />
                                                <button class="btn btn-sm btn-outline-secondary">@(isActive ? "Deactivate" : "Activate")</button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(module) && new[] { "residents", "guests", "parcels", "complaints", "amenity-logs" }.Contains(module))
    {
        <div class="mt-3">
            <a asp-action="Report" asp-route-module="@module" class="btn btn-outline-secondary">Open @ViewBag.Title report</a>
        </div>
    }
</div>

<script>
    (function () {
        const searchInput = document.getElementById('tableSearch');
        const wingFilter = document.getElementById('wingFilter');
        function applyFilters() {
            const q = (searchInput?.value || '').toLowerCase();
            const w = (wingFilter?.value || '').toLowerCase();
            document.querySelectorAll('#dataRows tr').forEach(r => {
                const txt = r.innerText.toLowerCase();
                r.hidden = (q && !txt.includes(q)) || (w && !txt.includes(w));
            });
        }
        searchInput?.addEventListener('input', applyFilters);
        wingFilter?.addEventListener('change', applyFilters);
    })();
</script>
