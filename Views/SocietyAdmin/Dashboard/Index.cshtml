@using System.Text.Json
@{ Layout = "_SocietyAdminLayout"; ViewData["Title"]="Dashboard"; var data = ViewBag.DashboardData is JsonElement j ? j : default; }
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4"><div><div class="small text-primary fw-semibold text-uppercase">Overview</div><h2 class="fw-bold mb-1">Welcome, @ViewBag.FullName</h2><p class="text-secondary mb-0">Your society's latest backend dashboard summary.</p></div><span class="badge text-bg-success rounded-pill px-3 py-2">Live dashboard</span></div>
@if(ViewBag.ErrorMessage!=null){<div class="alert alert-warning">@ViewBag.ErrorMessage</div>}
@if(data.ValueKind==JsonValueKind.Object){<div class="row g-3 mb-4">@foreach(var p in data.EnumerateObject()){<div class="col-sm-6 col-xl-3"><div class="card border-0 shadow-sm h-100"><div class="card-body"><div class="text-secondary small">@System.Text.RegularExpressions.Regex.Replace(p.Name,"([a-z])([A-Z])","$1 $2")</div><div class="h3 fw-bold mt-2 mb-0">@p.Value.ToString()</div></div></div></div>}</div>}else{<div class="alert alert-light border">The backend did not return dashboard summary fields.</div>}
<div class="card border-0 shadow-sm"><div class="card-body p-4"><h5 class="fw-bold">Quick actions</h5><p class="text-secondary">Jump directly to the management area you need.</p><div class="d-flex flex-wrap gap-2">@foreach(var item in new[]{("Wings","wings"),("Floors","floors"),("Flats","flats"),("Residents","residents"),("Amenities","amenities"),("Guest entries","guests"),("Parcels","parcels"),("Complaints","complaints"),("Notifications","notifications")}){<a asp-action="Index" asp-route-module="@item.Item2" class="btn btn-outline-primary">@item.Item1</a>}</div></div></div>
