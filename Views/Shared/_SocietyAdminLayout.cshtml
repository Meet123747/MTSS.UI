@using Microsoft.AspNetCore.Http
<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>@ViewData["Title"] - MTSS Society Admin</title><link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/><link rel="stylesheet" href="~/css/society-admin.css" asp-append-version="true"/></head>
<body><div class="sa-shell"><aside class="sa-sidebar"><div class="sa-brand"><span class="sa-mark">M</span><span>MTSS <small>Society Admin</small></span></div><div class="sa-section">WORKSPACE</div><a asp-controller="SocietyAdminModules" asp-action="Dashboard">Dashboard</a><div class="sa-section">SOCIETY SETUP</div><a asp-controller="SocietyAdminModules" asp-action="Index" asp-route-module="wings">Wings</a><a asp-controller="SocietyAdminModules" asp-action="Index" asp-route-module="floors">Floors</a><a asp-controller="SocietyAdminModules" asp-action="Index" asp-route-module="flats">Flats</a><a asp-controller="SocietyAdminModules" asp-action="Index" asp-route-module="residents">Residents</a><a asp-controller="SocietyAdminModules" asp-action="Index" asp-route-module="amenities">Amenities</a><div class="sa-section">OPERATIONS</div><a asp-controller="SocietyAdminModules" asp-action="Index" asp-route-module="guests">Guest entries</a><a asp-controller="SocietyAdminModules" asp-action="Index" asp-route-module="parcels">Parcels</a><a asp-controller="SocietyAdminModules" asp-action="Index" asp-route-module="complaints">Complaints</a><a asp-controller="SocietyAdminModules" asp-action="Index" asp-route-module="notifications">Notifications</a><a asp-controller="SocietyAdminModules" asp-action="Index" asp-route-module="amenity-logs">Amenity access logs</a><a asp-controller="SocietyAdminModules" asp-action="Index" asp-route-module="amenity-pins">Amenity PIN records</a><a asp-controller="SocietyAdminModules" asp-action="ValidateAmenityPin">Validate amenity PIN</a><div class="sa-spacer"></div><form asp-controller="Auth" asp-action="Logout" method="post">@Html.AntiForgeryToken()<button class="sa-logout" type="submit">Logout</button></form></aside><main class="sa-main"><header class="sa-topbar"><div><strong>Society workspace</strong><div class="text-secondary small">Manage your community operations</div></div><div class="sa-user">@Context.Session.GetString("FullName")</div></header><div class="sa-content">@RenderBody()</div></main></div><script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>@await RenderSectionAsync("Scripts", required:false)</body></html>
