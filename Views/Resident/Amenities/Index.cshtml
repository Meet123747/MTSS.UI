@using System.Text.Json
@{
    ViewData["Title"] = "Amenity PINs";
    ViewData["PageHeading"] = "Amenity access";
    var rows = ViewBag.Rows as List<JsonElement> ?? new();
    string Val(JsonElement row, params string[] keys)
    {
        if (row.ValueKind != JsonValueKind.Object) return "";
        foreach (var k in keys)
            if (row.TryGetProperty(k, out var v) && v.ValueKind != JsonValueKind.Null)
                return v.ToString();
        return "";
    }
    string FormatDate(string raw) => DateTime.TryParse(raw, out var dt) ? dt.ToString("dd MMM yyyy, hh:mm tt") : (string.IsNullOrWhiteSpace(raw) ? "—" : raw);
    var statuses = rows.Select(r => Val(r, "status")).Where(s => !string.IsNullOrWhiteSpace(s)).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(s => s).ToList();
}

<div class="page-intro">
    <div>
        <div class="page-eyebrow">COMMUNITY AMENITIES</div>
        <h1 class="page-title">My Amenity PINs</h1>
        <p class="page-subtitle">View your amenity access history or revoke an active unused PIN. Raw PINs are shown only at generation.</p>
    </div>
    <a class="btn btn-resident" asp-action="GeneratePin"><span data-icon="plus" class="mtss-icon-sm"></span> Generate PIN</a>
</div>

@if (ViewBag.ErrorMessage != null) { <div class="alert alert-danger resident-alert">@ViewBag.ErrorMessage</div> }

<div class="resident-card">
    @if (rows.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-icon"><span data-icon="key"></span></div>
            <strong>No amenity PINs found</strong>
            <p>Generate a PIN when you need amenity access.</p>
            <a class="btn btn-resident mt-3" asp-action="GeneratePin">Generate a PIN</a>
        </div>
    }
    else
    {
        <div class="resident-toolbar">
            <div><h2 class="section-heading">My PIN Records <span class="badge text-bg-light ms-1">@rows.Count</span></h2></div>
            <div class="resident-toolbar-controls">
                <select id="pinStatusFilter" class="form-select" style="width:auto">
                    <option value="">All statuses</option>
                    @foreach (var s in statuses)
                    {
                        <option value="@s.ToLowerInvariant()">@s</option>
                    }
                </select>
                <input id="pinSearch" class="form-control" style="width:220px" placeholder="Search by amenity..." />
            </div>
        </div>
        <div class="resident-table-wrap">
            <table class="resident-table resident-table-cards">
                <thead>
                    <tr>
                        <th>Amenity</th>
                        <th>Status</th>
                        <th>Generated</th>
                        <th>Expires</th>
                        <th>Used At</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="pinRows">
                    @foreach (var row in rows)
                    {
                        var idText = Val(row, "amenityAccessPinId", "id");
                        var amenity = Val(row, "amenityName");
                        var status = Val(row, "status");
                        var generated = Val(row, "generatedAt", "createdAt");
                        var expires = Val(row, "expiresAt");
                        var usedAt = Val(row, "usedAt");
                        var isActive = status.Equals("Active", StringComparison.OrdinalIgnoreCase);
                        var pillClass = status.Equals("Active", StringComparison.OrdinalIgnoreCase)
                            ? "success"
                            : status.Equals("Used", StringComparison.OrdinalIgnoreCase)
                                ? ""
                                : status.Equals("Expired", StringComparison.OrdinalIgnoreCase)
                                    ? "warning"
                                    : "danger";

                        <tr data-status="@status.ToLowerInvariant()">
                            <td data-label="Amenity"><strong>@(string.IsNullOrWhiteSpace(amenity) ? "Amenity" : amenity)</strong></td>
                            <td data-label="Status"><span class="status-pill @pillClass">@(string.IsNullOrWhiteSpace(status) ? "Unknown" : status)</span></td>
                            <td data-label="Generated">@FormatDate(generated)</td>
                            <td data-label="Expires">@FormatDate(expires)</td>
                            <td data-label="Used at">@FormatDate(usedAt)</td>
                            <td data-label="Actions" class="d-flex gap-2 align-items-center">
                                @if (int.TryParse(idText, out var id))
                                {
                                    <a class="action-link" asp-action="PinDetails" asp-route-id="@id">Details</a>
                                    @if (isActive && string.IsNullOrWhiteSpace(usedAt))
                                    {
                                        <form asp-action="RevokePin" method="post" onsubmit="return confirm('Are you sure you want to revoke this active PIN?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@id" />
                                            <button class="action-link border-0 bg-transparent p-0 text-danger" type="submit">Revoke</button>
                                        </form>
                                    }
                                }
                                else
                                {
                                    <span class="text-secondary">—</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
<div class="section-note mt-3">PINs are valid for 15 minutes, single-use, and stored as hashes by the backend.</div>

@section Scripts {
    <script>
        (function () {
            const search = document.getElementById('pinSearch');
            const filter = document.getElementById('pinStatusFilter');
            function apply() {
                const q = (search?.value || '').toLowerCase();
                const st = (filter?.value || '').toLowerCase();
                document.querySelectorAll('#pinRows tr').forEach(r => {
                    const matchQ = !q || r.innerText.toLowerCase().includes(q);
                    const matchS = !st || r.dataset.status === st;
                    r.hidden = !(matchQ && matchS);
                });
            }
            search?.addEventListener('input', apply);
            filter?.addEventListener('change', apply);
        })();
    </script>
}
