@{
    ViewData["Title"] = "Guest Management";
    ViewData["PageHeading"] = "Guest management";
}

<div class="page-intro">
    <div>
        <div class="page-eyebrow">RESIDENT SERVICES</div>
        <h1 class="page-title">Guest Management</h1>
        <p class="page-subtitle">Guest entry information for your residence.</p>
    </div>
    <a class="btn btn-outline-resident" asp-action="Dashboard">← Back to Overview</a>
</div>

<div class="resident-card resident-card-body">
    <div class="empty-state">
        <div class="empty-icon"><span data-icon="users"></span></div>
        <strong>Guest entries are managed centrally</strong>
        <p class="mx-auto" style="max-width:560px">
            Guest registration, entry verification and approval are centrally managed by the SocietyAdmin panel to maintain security and controlled access.
            Residents should contact their SocietyAdmin for guest-entry assistance.
        </p>
    </div>
</div>
