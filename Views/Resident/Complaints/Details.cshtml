@using System.Text.Json
@using System.Text.RegularExpressions
@{
    ViewData["Title"] = "Complaint Details";
    ViewData["PageHeading"] = "Complaint details";
    var record = ViewBag.Record as JsonElement?;
    string FormatLabel(string key) => Regex.Replace(key, "([a-z])([A-Z])", "$1 $2");
    string FormatVal(string key, JsonElement val)
    {
        if (val.ValueKind == JsonValueKind.Null) return "—";
        var s = val.ToString();
        if (key.EndsWith("At", StringComparison.OrdinalIgnoreCase) && DateTime.TryParse(s, out var dt))
            return dt.ToString("dd MMM yyyy, hh:mm tt");
        return string.IsNullOrWhiteSpace(s) ? "—" : s;
    }
}
<div class="page-intro">
    <div>
        <div class="page-eyebrow">SUPPORT CENTER</div>
        <h1 class="page-title">Complaint details</h1>
        <p class="page-subtitle">Full details and any admin remarks for your complaint.</p>
    </div>
    <a class="btn btn-outline-resident" asp-action="Complaints">← Back</a>
</div>
<div class="resident-card resident-card-body">
    @if (record.HasValue && record.Value.ValueKind == JsonValueKind.Object)
    {
        <div class="detail-grid">
            @foreach (var property in record.Value.EnumerateObject())
            {
                <div class="detail-item">
                    <small class="text-capitalize">@FormatLabel(property.Name)</small>
                    <strong>@FormatVal(property.Name, property.Value)</strong>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state"><strong>No detail data returned</strong></div>
    }
</div>
